---
import BaseLayout from '../layouts/BaseLayout.astro';

// 협력 파트너 목록 — 신규 파트너 추가 시 이 배열에만 추가
// type: 'pro'(레슨프로) | 'fitter'(피팅 전문가)
// status: 'active'(노출) | 'pending'(준비 중, 숨김)
const partners = [
  {
    type: 'pro',
    status: 'active',
    region: '서울 강남',
    name: '○○골프아카데미',
    pro: '홍길동 프로',
    credentials: ['KPGA 프로', 'TrackMan 레슨'],
    services: [
      { name: '레슨 (개인 회원제)', priceNote: '월 단위 상담' },
      { name: '원포인트 레슨', price: 60000, unit: '1회' },
    ],
    summary:
      '클럽메이커스와 협력해 측정·분석 데이터를 바탕으로 스윙 교정을 진행합니다. 트랙맨 데이터를 함께 보며 원인부터 잡습니다.',
    focus: '슬라이스·훅 교정, 비거리 증대, 임팩트 안정화',
    contact: { kakao: null, phone: null, web: null },
    isExample: true,
  },
  {
    type: 'fitter',
    status: 'active',
    region: '경기 분당',
    name: '○○피팅스튜디오',
    pro: '김길동 피터',
    credentials: ['클럽메이커스 교육 수료', 'GMC 피터'],
    services: [
      { name: '드라이버 피팅', price: 200000, unit: '1회' },
      { name: '아이언 세트 피팅', price: 350000, unit: '1세트' },
      { name: '샤프트·그립 교체', priceNote: '부품가 별도' },
    ],
    summary:
      '클럽메이커스 시스템 피팅 방법론을 공유하며, 동일한 진단 기준으로 작업합니다. 양재 방문이 어려운 분께 지역 파트너로 연결합니다.',
    focus: '드라이버 피팅, 아이언 라이각·SW 매칭, 샤프트 교체',
    contact: { kakao: null, phone: null, web: null },
    isExample: true,
  },
];

const activePartners = partners.filter((p) => p.status === 'active');
const typeLabel = { pro: '레슨 프로', fitter: '피팅 전문가' };

const fmt = (n) => n.toLocaleString('ko-KR');
---

<BaseLayout
  title="협력 파트너 — 프로·피팅 전문가 네트워크"
  description="클럽메이커스 협력 파트너 — 레슨 프로와 피팅 전문가를 모십니다. 스윙은 코치가, 결과는 클럽이. 두 영역을 같은 데이터 기준으로 잇습니다."
>
  <section class="partners-hero">
    <div class="container">
      <p class="eyebrow">PARTNERS · 협력 네트워크</p>
      <h1>프로님·피팅 전문가,<br />파트너로 모십니다</h1>
      <p class="lead">
        스윙은 코치가, 결과는 클럽이 만듭니다. 두 영역을 같은 데이터 기준으로
        잇는 협력 네트워크를 만들고 있습니다.
      </p>
      <div class="hero-meta">
        <a href="#join" class="btn btn-primary">파트너 신청 안내 →</a>
        <a href="#partners" class="btn btn-ghost">파트너 보기</a>
      </div>
    </div>
  </section>

  <section class="partners-intro">
    <div class="container narrow">
      <h2>같은 진단, 다른 역할</h2>
      <p>
        고객의 문제가 <strong>스윙에서 비롯됐다면 레슨 프로</strong>가, <strong>클럽에서 비롯됐다면 피팅 전문가</strong>가
        이어받습니다. 클럽메이커스의 진단 리포트(K-Vest·론치모니터·TPI 기반)를
        같은 기준으로 공유하기 때문에, 손님은 같은 이야기를 두 번 하지 않아도
        됩니다.
      </p>
      <p class="note">
        ※ 아래는 협력 네트워크의 <strong>대표 예시</strong>입니다. 실제 파트너 모집을
        시작하는 단계로, 정식 등록되는 분들로 곧 업데이트됩니다.
      </p>
    </div>
  </section>

  <section id="partners" class="partners-list">
    <div class="container">
      <div class="partners-grid">
        {activePartners.map((p) => (
          <article class={`partner-card partner-${p.type}`}>
            <header class="partner-card-head">
              <span class={`partner-type partner-type-${p.type}`}>
                {typeLabel[p.type]}
              </span>
              <span class="partner-region">{p.region}</span>
              {p.isExample && <span class="partner-example">예시</span>}
            </header>

            <h3 class="partner-name">{p.name}</h3>
            <p class="partner-pro">{p.pro}</p>

            <div class="partner-credentials">
              {p.credentials.map((c) => (
                <span class="cred">{c}</span>
              ))}
            </div>

            <p class="partner-summary">{p.summary}</p>

            <div class="partner-focus">
              <span class="focus-label">주력</span>
              <span class="focus-text">{p.focus}</span>
            </div>

            <ul class="partner-services">
              {p.services.map((s) => (
                <li>
                  <span class="svc-name">{s.name}</span>
                  <span class="svc-price">
                    {s.price
                      ? `${fmt(s.price)}원${s.unit ? ` / ${s.unit}` : ''}`
                      : s.priceNote}
                  </span>
                </li>
              ))}
            </ul>

            <footer class="partner-card-foot">
              {p.contact.kakao || p.contact.phone || p.contact.web ? (
                <div class="partner-contact">
                  {p.contact.phone && (
                    <a href={`tel:${p.contact.phone}`} class="contact-btn">
                      전화
                    </a>
                  )}
                  {p.contact.kakao && (
                    <a
                      href={p.contact.kakao}
                      target="_blank"
                      rel="noopener"
                      class="contact-btn"
                    >
                      카카오
                    </a>
                  )}
                  {p.contact.web && (
                    <a
                      href={p.contact.web}
                      target="_blank"
                      rel="noopener"
                      class="contact-btn"
                    >
                      홈페이지
                    </a>
                  )}
                </div>
              ) : (
                <p class="partner-contact-note">
                  연락처는 정식 등록 후 안내됩니다
                </p>
              )}
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="join" class="partners-join">
    <div class="container narrow">
      <p class="eyebrow">JOIN · 파트너 신청</p>
      <h2>함께 일할 분을 찾습니다</h2>
      <p class="lead">
        지역별 레슨 프로와 피팅 전문가를 모십니다. 같은 진단 기준을 공유하고,
        손님을 서로 잇는 네트워크입니다.
      </p>

      <div class="join-grid">
        <div class="join-card">
          <h3>레슨 프로</h3>
          <ul>
            <li>KPGA · KLPGA · 티칭 프로 자격 보유자</li>
            <li>론치모니터·트랙맨·K-Vest 등 데이터 활용 경험</li>
            <li>지역 거점에서 활동 중인 분</li>
          </ul>
        </div>
        <div class="join-card">
          <h3>피팅 전문가</h3>
          <ul>
            <li>클럽피팅·메이킹 경력자</li>
            <li>클럽메이커스 교육 과정 수료자 우대</li>
            <li>본인 스튜디오·작업 공간 보유</li>
          </ul>
        </div>
      </div>

      <div class="join-cta">
        <p>신청·문의는 아래로 연락 주세요.</p>
        <div class="join-buttons">
          <a
            href="https://open.kakao.com/o/sLAG3lbb"
            target="_blank"
            rel="noopener"
            class="btn btn-kakao"
          >
            카카오톡 문의
          </a>
          <a href="mailto:clubmakers@naver.com" class="btn btn-mail">
            clubmakers@naver.com
          </a>
          <a href="tel:010-4363-5555" class="btn btn-call">전화 010-4363-5555</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 공통 컨테이너 */
  .container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .container.narrow {
    max-width: 760px;
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--gold, #b8985c);
    font-weight: 700;
    margin: 0 0 8px;
  }

  /* HERO */
  .partners-hero {
    background: var(--bg-cream, #f8f2e5);
    padding: 60px 0 56px;
    border-bottom: 1px solid var(--line, #e5ded1);
  }
  .partners-hero h1 {
    font-family: var(--font-serif, 'Noto Serif KR', serif);
    font-size: 32px;
    line-height: 1.35;
    margin: 0 0 14px;
    color: var(--ink, #0f0f0e);
  }
  .partners-hero .lead {
    font-size: 15px;
    line-height: 1.8;
    color: var(--grey, #555);
    max-width: 560px;
    margin: 0 0 24px;
  }
  .hero-meta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 11px 20px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
  }
  .btn-primary {
    background: var(--green, #0f2922);
    color: #fff;
  }
  .btn-ghost {
    background: transparent;
    color: var(--green, #0f2922);
    border: 1px solid var(--green, #0f2922);
  }
  .btn-kakao {
    background: #fee500;
    color: #3c1e1e;
  }
  .btn-mail {
    background: #fff;
    color: var(--ink, #0f0f0e);
    border: 1px solid var(--line, #e5ded1);
  }
  .btn-call {
    background: var(--green, #0f2922);
    color: #fff;
  }

  /* INTRO */
  .partners-intro {
    padding: 56px 0 40px;
  }
  .partners-intro h2 {
    font-family: var(--font-serif, 'Noto Serif KR', serif);
    font-size: 24px;
    margin: 0 0 14px;
  }
  .partners-intro p {
    font-size: 15px;
    line-height: 1.85;
    color: var(--grey, #444);
    margin: 0 0 14px;
  }
  .partners-intro .note {
    font-size: 13px;
    color: var(--grey, #666);
    background: var(--bg-cream, #f8f2e5);
    border-left: 3px solid var(--gold, #b8985c);
    padding: 12px 16px;
    border-radius: 0 2px 2px 0;
    margin-top: 8px;
  }

  /* PARTNERS LIST */
  .partners-list {
    padding: 24px 0 64px;
  }
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }
  .partner-card {
    background: #fff;
    border: 1px solid var(--line, #e5ded1);
    border-top: 3px solid var(--gold, #b8985c);
    border-radius: 6px;
    padding: 22px 22px 18px;
    display: flex;
    flex-direction: column;
  }
  .partner-card.partner-pro {
    border-top-color: var(--green, #0f2922);
  }
  .partner-card-head {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .partner-type {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 10px;
    letter-spacing: 0.02em;
  }
  .partner-type-pro {
    background: var(--green, #0f2922);
    color: #fff;
  }
  .partner-type-fitter {
    background: var(--gold, #b8985c);
    color: #fff;
  }
  .partner-region {
    font-size: 12px;
    color: var(--grey, #666);
    font-weight: 600;
  }
  .partner-example {
    font-size: 10.5px;
    font-weight: 700;
    color: var(--grey, #888);
    background: #fff;
    border: 1px dashed var(--line, #e5ded1);
    padding: 2px 8px;
    border-radius: 10px;
    margin-left: auto;
  }
  .partner-name {
    font-family: var(--font-serif, 'Noto Serif KR', serif);
    font-size: 19px;
    font-weight: 700;
    margin: 0 0 3px;
    color: var(--ink, #0f0f0e);
  }
  .partner-pro {
    font-size: 14px;
    color: var(--grey, #555);
    margin: 0 0 12px;
    font-weight: 600;
  }
  .partner-credentials {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 12px;
  }
  .cred {
    font-size: 11.5px;
    color: var(--green, #0f2922);
    background: var(--bg-cream, #f8f2e5);
    border: 1px solid var(--line, #e5ded1);
    padding: 3px 9px;
    border-radius: 10px;
    font-weight: 600;
  }
  .partner-summary {
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--grey, #444);
    margin: 0 0 12px;
  }
  .partner-focus {
    background: var(--bg-cream, #f8f2e5);
    border-left: 2px solid var(--gold, #b8985c);
    padding: 9px 12px;
    border-radius: 0 2px 2px 0;
    margin-bottom: 14px;
  }
  .focus-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    color: var(--green, #0f2922);
    margin-bottom: 3px;
    letter-spacing: 0.04em;
  }
  .focus-text {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--ink, #0f0f0e);
  }
  .partner-services {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    border-top: 1px solid var(--line, #e5ded1);
  }
  .partner-services li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--line, #e5ded1);
    gap: 10px;
  }
  .svc-name {
    font-size: 13px;
    color: var(--ink, #0f0f0e);
  }
  .svc-price {
    font-size: 13px;
    font-weight: 700;
    color: var(--green, #0f2922);
    white-space: nowrap;
  }
  .partner-card-foot {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line, #e5ded1);
  }
  .partner-contact {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .contact-btn {
    flex: 1;
    text-align: center;
    padding: 9px 12px;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    color: var(--green, #0f2922);
    background: var(--bg-cream, #f8f2e5);
    border-radius: 3px;
  }
  .partner-contact-note {
    margin: 0;
    font-size: 12px;
    color: var(--grey, #888);
    text-align: center;
  }

  /* JOIN */
  .partners-join {
    background: var(--bg-cream, #f8f2e5);
    padding: 56px 0 64px;
    border-top: 1px solid var(--line, #e5ded1);
  }
  .partners-join h2 {
    font-family: var(--font-serif, 'Noto Serif KR', serif);
    font-size: 24px;
    margin: 0 0 12px;
  }
  .partners-join .lead {
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--grey, #555);
    margin: 0 0 28px;
  }
  .join-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 28px;
  }
  .join-card {
    background: #fff;
    border: 1px solid var(--line, #e5ded1);
    border-radius: 6px;
    padding: 22px;
  }
  .join-card h3 {
    font-size: 17px;
    margin: 0 0 12px;
    color: var(--green, #0f2922);
  }
  .join-card ul {
    margin: 0;
    padding-left: 18px;
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--grey, #444);
  }
  .join-card li {
    margin-bottom: 4px;
  }
  .join-cta {
    background: #fff;
    border: 1px solid var(--line, #e5ded1);
    border-radius: 6px;
    padding: 22px;
    text-align: center;
  }
  .join-cta p {
    margin: 0 0 14px;
    font-size: 14px;
    color: var(--grey, #444);
  }
  .join-buttons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 680px) {
    .partners-hero {
      padding: 44px 0 40px;
    }
    .partners-hero h1 {
      font-size: 26px;
    }
    .join-grid {
      grid-template-columns: 1fr;
    }
    .partner-services li {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
    .svc-price {
      font-size: 14px;
    }
  }
</style>
