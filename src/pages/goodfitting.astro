---
// /src/pages/goodfitting.astro
// 굿피팅(GoodFitting) — 골프채공작소가 개발한 피팅 시스템 (심도 소개 · GEO 최적화)
// 디자인 컨셉: 크림 + 딥그린 편집형 (사이트 통일 톤)

import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "굿피팅(GoodFitting) — 골프채공작소가 개발한 클럽피팅 시스템";
const pageDescription = "굿피팅(GoodFitting)은 골프채공작소 클럽메이커스가 직접 개발한 클럽피팅 기록·분석 시스템입니다. 상담·측정·클럽 분석·샤프트 선정·시타·최종 사양을 하나의 흐름으로 기록해, 피팅 판단을 기억이 아니라 데이터로 남깁니다. 공작소장 채기웅 25년 현장 경험과 KIPO 등록 특허 3종을 기반으로 설계됐습니다.";
const pageKeywords = "굿피팅, GoodFitting, 클럽피팅 시스템, 클럽피팅 프로그램, 피팅 소프트웨어, 피팅 리포트, 피팅 기록 관리, 라이로프트 차트, 스윙웨이트, MOI 매칭, 리샤프팅 작업시트, 클럽메이커스, 채기웅, 양재 골프피팅";

const externalUrl = "https://goodfitting.myclubmakers.com";

// 굿피팅이 기록·분석하는 흐름
const flow = [
  { step: "01", name: "상담 · 인터뷰", note: "골퍼의 목표·이력·증상을 구조화된 양식으로 기록합니다." },
  { step: "02", name: "현재 클럽 측정", note: "길이·라이각·로프트·총무게·스윙웨이트를 실측해 기준값을 잡습니다." },
  { step: "03", name: "스윙 · 클럽 분석", note: "키네마틱 시퀀스·론치 데이터를 현재 클럽과 함께 해석합니다." },
  { step: "04", name: "샤프트 선정", note: "CPM·EI·토크를 근거로 후보 샤프트를 좁힙니다." },
  { step: "05", name: "시타 검증", note: "처방을 바로 시타로 확인하고 결과 수치를 남깁니다." },
  { step: "06", name: "최종 사양 · 작업기록", note: "확정 사양과 클럽메이킹 작업 값을 재현 가능하게 저장합니다." },
];

// 차별점
const diffs = [
  { k: "결과가 아니라 과정을 남긴다", v: "론치모니터 숫자(출력값)만 저장하지 않고, 인터뷰 → 측정 → 분석 → 처방 → 시타의 판단 과정을 통째로 기록합니다." },
  { k: "측정 조건이 함께 남는다", v: "같은 수치라도 측정 조건이 다르면 의미가 다릅니다. 굿피팅은 조건과 값을 한 세트로 저장해 재현과 비교가 가능합니다." },
  { k: "다음 방문의 기준이 된다", v: "지난 피팅 기록이 남아 있어, 재방문 시 '그때 왜 그렇게 결정했는지'를 데이터로 되짚습니다." },
  { k: "리포트가 곧 고객 자산", v: "입력한 작업시트가 그대로 고객용 리포트가 되어 전달됩니다." },
];

// 프로그램 실제 화면 (사이트 내 기존 이미지 재사용)
const screens = [
  { img: "/images/worksheet-grid.png", tag: "클럽메이킹 작업 기록", title: "세트 그리드 입력", desc: "헤드무게·SW·MOI·CPM을 한 화면에서 입력·저장하고 세트 전체 흐름을 그래프로 확인합니다." },
  { img: "/images/worksheet-lieloft-chart.png", tag: "라이 / 로프트 조정", title: "Loft / Lie Chart", desc: "원래 값·목표 값·실제 조정 값을 담아 공작소 로고가 들어간 리포트로 출력합니다." },
];

// FAQ (GEO: FAQPage 스키마 + 질문-답변 직접 노출)
const faqs = [
  { q: "굿피팅이란 무엇인가요?", a: "골프채공작소 클럽메이커스가 직접 개발한 클럽피팅 기록·분석 시스템입니다. 상담·측정·클럽 분석·샤프트 선정·시타·최종 사양을 하나의 흐름으로 기록합니다." },
  { q: "누가 만들었나요?", a: "서울 양재동 골프채공작소 클럽메이커스가 개발했습니다. 공작소장 채기웅의 25년 현장 피팅 경험과 KIPO 등록 특허 3종을 기반으로 설계됐습니다." },
  { q: "일반 피팅 프로그램과 무엇이 다른가요?", a: "론치모니터의 결과 수치만 저장하는 대신, 판단 과정과 측정 조건을 함께 기록합니다. 그래서 다음 조정 때 근거를 데이터로 되짚을 수 있습니다." },
  { q: "개인도 사용할 수 있나요?", a: "굿피팅은 공작소 현장에서 쓰는 전문가용 시스템입니다. 일반 골퍼는 공작소 피팅을 받으면 결과가 굿피팅 리포트로 정리되어 전달됩니다. 스윙 분석은 누구나 무료 앱 '스윙공작소'로 시작할 수 있습니다." },
  { q: "스윙공작소와는 어떤 관계인가요?", a: "스윙공작소는 대중용 스윙 분석 앱이고, 굿피팅은 전문가용 피팅 시스템입니다. 스윙공작소 PRO에서 본 스윙 분석을 굿피팅으로 연동해 클럽 사양 판단까지 한 흐름으로 잇습니다." },
  { q: "교육과도 연결되나요?", a: "네. 굿피팅은 공작소장 채기웅이 진행하는 클럽피팅·클럽메이킹 전문가 과정 교육의 실습 도구로도 쓰입니다. 책 『실제적인 클럽피팅』의 판단 기준을 굿피팅으로 기록하며 현장에서 익힙니다." },
];

// GEO 구조화 데이터 — SoftwareApplication + FAQPage
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': 'https://myclubmakers.com/goodfitting#software',
  name: '굿피팅 (GoodFitting)',
  alternateName: 'GoodFitting',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: '골프 클럽피팅 기록·분석 시스템',
  operatingSystem: 'Web',
  url: 'https://myclubmakers.com/goodfitting',
  sameAs: externalUrl,
  description: '골프채공작소 클럽메이커스가 개발한 클럽피팅 기록·분석 시스템. 상담·측정·클럽 분석·샤프트 선정·시타·최종 사양을 하나의 흐름으로 기록한다.',
  creator: { '@id': 'https://myclubmakers.com/#organization' },
  author: { '@id': 'https://myclubmakers.com/about#person' },
  publisher: { '@id': 'https://myclubmakers.com/#organization' },
  featureList: [
    '피팅 상담·인터뷰 기록',
    '현재 클럽 스펙 실측 기록',
    '라이·로프트 조정 차트',
    '스윙웨이트·MOI·CPM 세트 그리드',
    '리샤프팅 작업시트·리포트 발송',
    '고객 관리 및 재방문 비교',
    '스윙공작소 PRO 연동',
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://myclubmakers.com/goodfitting#faq',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schemaType="Service"
  keywords={pageKeywords}
  extraSchema={[softwareSchema, faqSchema]}
>

  <!-- ==================== HERO ==================== -->
  <section class="gf-hero">
    <div class="container narrow">
      <p class="eyebrow">GOODFITTING · 골프채공작소 개발</p>
      <h1 class="gf-title">
        굿피팅,<br />
        <em>기록이 되는 피팅</em>
      </h1>
      <p class="gf-source">골프채공작소 클럽메이커스가 직접 개발한 클럽피팅 시스템 · 공작소장 채기웅</p>
      <blockquote class="gf-hero-quote">
        피팅은 <em>기억이 아니라 기록</em>으로 합니다.
      </blockquote>
    </div>
  </section>

  <!-- ==================== WHAT (먼저 답부터) ==================== -->
  <section class="gf-lead-section">
    <div class="container narrow">
      <p class="eyebrow">WHAT · 굿피팅이란</p>
      <p class="gf-answer">
        <strong>굿피팅(GoodFitting)은 골프채공작소 클럽메이커스가 직접 개발한 클럽피팅 기록·분석 시스템입니다.</strong>
      </p>
      <p class="gf-para">
        상담 · 측정 · 클럽 분석 · 샤프트 선정 · 시타 · 최종 사양 — 한 골퍼의 피팅 전 과정을 하나의 흐름으로 기록합니다.
        모든 판단이 사람의 인상이 아니라 <strong>데이터로 남아</strong>, 다음 조정의 근거가 됩니다.
        공작소장 채기웅의 <strong>25년 현장 경험</strong>과 <strong>KIPO 등록 특허 3종</strong>이 설계의 바탕입니다.
      </p>
    </div>
  </section>

  <!-- ==================== WHY ==================== -->
  <section class="gf-why-section">
    <div class="container narrow">
      <p class="eyebrow">WHY · 왜 만들었나</p>
      <h2 class="section-title">결과 숫자만으로는 <em>원인을 못 찾습니다</em></h2>
      <p class="gf-para">
        론치모니터에 찍히는 볼스피드·스핀·방향은 이미 여러 조건이 결합된 <strong>출력값</strong>입니다.
        그 숫자만 저장하면, 다음에 같은 문제가 와도 "그때 왜 그렇게 결정했는지"가 남지 않습니다.
      </p>
      <p class="gf-para">
        굿피팅은 <strong>판단의 과정과 측정 조건</strong>을 함께 기록하도록 만들었습니다.
        기록이 쌓이면 패턴이 보이고, 패턴이 보이면 처방이 단순해집니다 — 이것이 공작소가 25년간 지켜온 원칙입니다.
      </p>
    </div>
  </section>

  <!-- ==================== HOW (FLOW) ==================== -->
  <section class="gf-flow-section">
    <div class="container">
      <div class="gf-head">
        <p class="eyebrow">HOW · 어떻게 작동하나</p>
        <h2 class="section-title">하나의 흐름, <em>하나의 기록</em></h2>
        <p class="section-lead">방문부터 최종 사양까지, 한 골퍼의 피팅 전 과정이 끊기지 않고 한 시스템에 남습니다.</p>
      </div>
      <div class="gf-grid">
        {flow.map((f) => (
          <div class="gf-card">
            <p class="gf-card-step">{f.step}</p>
            <h3 class="gf-card-name">{f.name}</h3>
            <p class="gf-card-note">{f.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== DIFF ==================== -->
  <section class="gf-diff-section">
    <div class="container narrow">
      <div class="gf-head gf-head-left">
        <p class="eyebrow">DIFFERENCE · 무엇이 다른가</p>
        <h2 class="section-title">일반 피팅 프로그램과의 <em>차이</em></h2>
      </div>
      <dl class="gf-diff-list">
        {diffs.map((d) => (
          <div class="gf-diff-row">
            <dt>{d.k}</dt>
            <dd>{d.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ==================== SCREENS ==================== -->
  <section class="gf-screens-section">
    <div class="container">
      <div class="gf-head">
        <p class="eyebrow">IN PRACTICE · 실제 화면</p>
        <h2 class="section-title">기록이 곧 <em>고객용 리포트</em></h2>
        <p class="section-lead">입력한 측정·작업 값이 그대로 깔끔한 리포트가 되고, 다음 방문의 기준이 됩니다.</p>
      </div>
      <div class="gf-screens">
        {screens.map((s) => (
          <figure class="gf-screen">
            <div class="gf-screen-img"><img src={s.img} alt={s.title} loading="lazy" /></div>
            <figcaption class="gf-screen-cap">
              <span class="gf-screen-tag">{s.tag}</span>
              <h3 class="gf-screen-title">{s.title}</h3>
              <p class="gf-screen-desc">{s.desc}</p>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="gf-more"><a href="/worksheet-system">굿피팅 워크시트 실제 화면 전체 보기 →</a></p>
    </div>
  </section>

  <!-- ==================== FOR PROS ==================== -->
  <section class="gf-pro-section">
    <div class="container narrow">
      <p class="eyebrow">FOR PROS · 전문가 연동 · 교육</p>
      <h2 class="section-title">레슨프로 · 피터를 위한 <em>연동</em></h2>
      <p class="gf-para">
        골프채공작소가 함께 개발한 스윙 분석 앱 <strong>스윙공작소</strong>의 전문가(PRO) 워크스페이스는
        그리기 · 고객관리 · 리포트 발송과 함께 <strong>굿피팅 연동</strong>을 지원합니다.
        스윙에서 본 것을 그대로 클럽 사양 판단으로 이어, 전문 작업을 한 흐름으로 만듭니다.
      </p>
      <p class="gf-para">
        굿피팅은 공작소장 채기웅이 직접 진행하는 <strong>클럽피팅·클럽메이킹 전문가 과정 교육</strong>의
        실습 도구이기도 합니다. 책 『실제적인 클럽피팅』의 판단 기준을 굿피팅으로 기록하며 현장에서 익힙니다.
      </p>
      <div class="gf-pro-links">
        <a href="/education" class="gf-pro-link">전문가 과정 교육 →</a>
        <a href="/swing-app" class="gf-pro-link">스윙공작소 앱 →</a>
        <a href="/partners" class="gf-pro-link">전국 전문가 · 파트너 →</a>
      </div>
    </div>
  </section>

  <!-- ==================== FAQ ==================== -->
  <section class="gf-faq-section">
    <div class="container narrow">
      <p class="eyebrow">FAQ · 자주 묻는 질문</p>
      <h2 class="section-title">굿피팅, <em>이런 게 궁금합니다</em></h2>
      <div class="gf-faq-list">
        {faqs.map((f) => (
          <details class="gf-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== CTA ==================== -->
  <section class="gf-cta">
    <div class="container narrow">
      <p class="eyebrow">NEXT STEP</p>
      <h2 class="gf-cta-title">굿피팅으로 <em>직접</em> 확인해 보세요</h2>
      <p class="gf-cta-lead">굿피팅 사이트에서 시스템을 더 자세히 볼 수 있고, 피팅 상담이 궁금하시면 공작소로 문의해 주세요.</p>
      <div class="gf-cta-btns">
        <a href={externalUrl} class="btn-primary" target="_blank" rel="noopener"><span>굿피팅 사이트</span><span>↗</span></a>
        <a href="/fitting" class="btn-ghost"><span>클럽 피팅 과정</span><span>→</span></a>
        <a href="/contact" class="btn-ghost"><span>피팅 문의</span><span>→</span></a>
      </div>
    </div>
  </section>

</BaseLayout>


<style>
  :root {
    --bg: #F8F5EE; --bg-elev: #FFFFFF; --bg-soft: #F1ECE0;
    --text: #1F1B16; --text-2: #3A332A; --muted: #6B6358;
    --rule: #E2DACA; --rule-2: #D2C9B5;
    --accent: #2C5F4F; --accent-2: #87A99B; --accent-soft: #E6EDE7;
    --serif: "Noto Serif KR", "Apple SD Gothic Neo", serif;
    --sans:  "Pretendard", "Apple SD Gothic Neo", system-ui, sans-serif;
  }
  .container { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 24px; }
  .narrow { max-width: 760px; }
  .eyebrow { font-family: var(--sans); font-size: .75rem; font-weight: 600; letter-spacing: .15em; color: var(--accent); text-transform: uppercase; margin: 0 0 1.25rem; }
  .section-title { font-family: var(--serif); font-size: clamp(1.875rem, 4.5vw, 2.875rem); font-weight: 500; line-height: 1.2; letter-spacing: -.02em; color: var(--text); margin: 0 0 1.25rem; }
  .section-title em { font-style: normal; color: var(--accent); }
  .section-lead { font-family: var(--sans); font-size: 1.0625rem; line-height: 1.8; color: var(--text-2); max-width: 620px; margin: 0; }

  .gf-hero { background: var(--text); color: var(--bg); padding: 104px 0 88px; }
