---
import BaseLayout from '../layouts/BaseLayout.astro';
const link = (path, medium) => `${path}?utm_source=swingworkshop&utm_medium=${medium}&utm_campaign=swing_care`;
const services = [
  { title: '전문 스윙분석', desc: '영상의 움직임을 실제 스윙과 신체 움직임과 함께 살펴봅니다.', path: '/swing-analysis' },
  { title: '클럽피팅', desc: '클럽 길이·무게·밸런스·샤프트 특성을 직접 측정합니다.', path: '/fitting' },
  { title: '수리·점검', desc: '그립·샤프트 교체부터 로프트·라이 조정까지 안내합니다.', path: '/workshop' },
];
---
<BaseLayout title="스윙공작소 사용자 안내 — 골프채공작소" description="스윙공작소 앱 사용자를 위한 골프채공작소의 전문 스윙분석, 클럽피팅, 수리·공임표, 방문 예약 안내." keywords="스윙공작소, 골프채공작소, 클럽피팅, 골프채수리, 스윙분석">
  <main class="care">
    <section class="hero">
      <div class="inner">
        <p class="eyebrow">SWING WORKSHOP × CLUBMAKERS</p>
        <h1>스윙을 살펴봤다면,<br /><em>이제 클럽도 확인해 보세요.</em></h1>
        <p class="lead">스윙공작소에서 확인한 움직임은 점검의 시작입니다. 같은 스윙 문제라도 신체 움직임, 타점, 클럽 특성에 따라 원인이 달라질 수 있습니다. 골프채공작소는 스윙과 클럽을 함께 살펴봅니다.</p>
        <div class="actions"><a class="primary" href={link('/contact','hero')}>예약·문의 안내 →</a><a class="secondary" href={link('/workshop','hero')}>수리·공임표 보기 →</a></div>
        <p class="caution">AI 영상 분석은 참고용이며, 영상만으로 클럽의 이상이나 교체 필요성을 확정할 수 없습니다.</p>
      </div>
    </section>
    <section class="section" aria-labelledby="services-title">
      <div class="inner">
        <p class="eyebrow">WHAT WE DO</p><h2 id="services-title">어떤 도움이 필요하신가요?</h2>
        <div class="grid">
          {services.map((s, i) => <a class="card" href={link(s.path,'service_card')}><span class="number">0{i + 1} / SERVICE</span><h3>{s.title}</h3><p>{s.desc}</p><strong>자세히 보기 →</strong></a>)}
        </div>
      </div>
    </section>
    <section class="section diagnosis" aria-labelledby="diagnosis-title">
      <div class="inner split">
        <div>
          <p class="eyebrow">SELF CHECK · 증상별 진단</p>
          <h2 id="diagnosis-title">슬라이스가 나는 이유,<br />하나만은 아닙니다.</h2>
          <p>슬라이스, 훅, 거리 부족, 탄도 문제처럼 자주 겪는 증상부터 살펴보세요. 골프채공작소의 증상별 진단 페이지에서 가능한 원인과 확인할 항목을 읽어볼 수 있습니다.</p>
          <p class="diagnosis-note">증상만으로 원인을 확정하지 않습니다. 스윙, 타점, 클럽 특성을 함께 확인해야 합니다.</p>
          <a class="diagnosis-cta" href={link('/topics','symptom_diagnosis')}>증상별 진단 살펴보기 →</a>
        </div>
        <div class="diagnosis-preview" aria-label="자주 겪는 증상 예시">
          <span>SYMPTOM GUIDE</span>
          <p>01 / 슬라이스</p>
          <p>02 / 훅</p>
          <p>03 / 거리 부족</p>
          <p>04 / 탄도 문제</p>
          <small>증상 선택 후 가능한 원인과 점검 순서를 확인하세요.</small>
        </div>
      </div>
    </section>
    <section class="section parcel" aria-labelledby="parcel-title">
      <div class="inner split">
        <div>
          <p class="eyebrow">SHIP-IN SERVICE · 택배 작업 문의</p>
          <h2 id="parcel-title">복잡한 접수 없이,<br />문의부터 간단하게.</h2>
          <p>샤프트 교체, 그립 교체, 클럽 수리·점검을 원하시나요? 신청서 작성이나 사진 첨부 없이, 문자 한 통 또는 전화 한 번으로 상담을 시작하세요. 방문과 택배 작업 모두 문의 가능합니다.</p>
          <div class="actions parcel-actions">
            <a class="diagnosis-cta" href="sms:01043635555" aria-label="골프채공작소에 문자 문의하기">문자로 문의하기 →</a>
            <a class="parcel-secondary" href="tel:01043635555" aria-label="골프채공작소에 전화 문의하기">전화로 문의하기 →</a>
          </div>
          <p class="diagnosis-note">자세한 클럽 정보나 사진은 필요할 때 상담 중 문자·카카오톡으로 받습니다. 택배 발송 주소와 비용은 상담 후 안내해 드립니다.</p>
        </div>
        <div class="parcel-steps">
          <div><span>01</span><strong>문자 또는 전화</strong><small>어떤 작업이 필요한지만 간단히 말씀해 주세요.</small></div>
          <div><span>02</span><strong>상담 및 안내</strong><small>필요한 정보만 추가로 확인하고 예상 비용을 안내합니다.</small></div>
          <div><span>03</span><strong>방문 또는 택배</strong><small>안내받은 방법으로 클럽을 맡겨주세요.</small></div>
        </div>
      </div>
    </section>
    <section class="section soft">
      <div class="inner split">
        <div><p class="eyebrow">PRICING</p><h2>가격과 작업 내용을<br />미리 확인하세요.</h2><p>공임 및 부품 가격은 홈페이지에서 최신 정보를 확인할 수 있습니다. 정확한 견적은 클럽 상태 확인 후 안내합니다.</p></div>
        <div class="links"><a href={link('/workshop','price')}>작업 공임 · 예상 견적 <span>→</span></a><a href={link('/price','price')}>샤프트 · 그립 등 부품 가격 <span>→</span></a><a href={link('/contact','price')}>방문 안내 · 예약 <span>→</span></a></div>
      </div>
    </section>
    <section class="section">
      <div class="inner split">
        <div><p class="eyebrow">ABOUT</p><h2>골프채공작소 클럽메이커스</h2><p>25년의 현장 경험을 바탕으로 인터뷰, 스윙 관찰, 클럽 실측을 종합해 필요한 작업을 제안합니다. 교체보다 점검이 먼저일 수 있습니다.</p><a class="about-link" href={link('/about','about')}>공작소 이야기 →</a></div>
        <div class="brand"><small>1985 — HERITAGE</small><strong>스윙을 이해하고<br />클럽을 만드는 곳.</strong><small>서울 서초구 양재동 · 골프채공작소</small></div>
      </div>
    </section>
    <section class="footer"><div class="inner"><p class="eyebrow">VISIT & CONTACT</p><h2>직접 확인하고 싶으신가요?</h2><p>분석과 교육은 예약제로 운영합니다. 수리 작업은 방문 전 연락 주시면 정확히 안내해 드립니다.</p><div class="actions"><a class="primary" href={link('/contact','footer')}>방문 예약·문의 안내 →</a><a class="secondary" href={link('/swing-app','footer')}>스윙공작소 앱 소개 →</a></div></div></section>
  </main>
</BaseLayout>
<style>
.care{background:#fbfaf7;color:#25231f}.inner{max-width:1080px;margin:auto;padding:0 24px}.hero{background:#19362d;color:white;padding:clamp(80px,10vw,130px) 0 90px}.eyebrow{font-size:12px;letter-spacing:.13em;font-weight:700;color:#7d9d89;margin-bottom:20px}.hero .eyebrow,.footer .eyebrow{color:#abc5b2}.hero h1{font-size:clamp(34px,5vw,62px);line-height:1.3;letter-spacing:-.05em;margin:0 0 25px}.hero em{font-style:normal;color:#cbdcca}.lead{font-size:18px;max-width:660px;line-height:1.85;color:#e2eae5}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.actions a{padding:14px 22px;border-radius:7px;text-decoration:none;font-weight:700}.primary{background:#dce9d9;color:#19382c}.secondary{border:1px solid currentColor;color:inherit}.caution{margin-top:28px;max-width:660px;font-size:13px;color:#c7d7cd}.section{padding:82px 0}.section h2,.footer h2{font-size:clamp(28px,3.5vw,42px);letter-spacing:-.04em;line-height:1.4;margin:0 0 22px}.section p{line-height:1.85}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:35px}.card{background:white;color:inherit;text-decoration:none;border:1px solid #e5e3dd;border-radius:12px;padding:30px;display:flex;flex-direction:column;min-height:250px}.card .number{color:#668774;font-size:12px}.card h3{font-size:23px;margin:23px 0 10px}.card p{color:#5e605a}.card strong{margin-top:auto;padding-top:20px;color:#2f674c;font-size:14px}.soft{background:#f1f3ed}.split{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.links{display:flex;flex-direction:column;gap:10px}.links a{display:flex;justify-content:space-between;gap:12px;background:white;padding:20px;border-radius:8px;text-decoration:none;color:#234536}.about-link{color:#28634b;font-weight:700}.brand{min-height:245px;padding:30px;background:#1c362d;color:white;border-radius:10px;display:flex;flex-direction:column;justify-content:space-between}.brand strong{font-size:30px;line-height:1.4}.brand small{color:#c1d2c5}.footer{background:#19362d;color:white;padding:76px 0}.footer p{line-height:1.8}@media(max-width:700px){.grid,.split{grid-template-columns:1fr;gap:18px}.section{padding:60px 0}.card{min-height:215px}.hero{padding:72px 0}.lead{font-size:16px}}
.diagnosis{background:#f7f8f3}.diagnosis-note{font-size:13px;color:#69766d;margin-top:13px}.diagnosis-cta{display:inline-block;background:#204d39;color:#fff;text-decoration:none;font-weight:700;padding:14px 20px;border-radius:8px;margin-top:23px}.diagnosis-preview{background:#fff;border:1px solid #dce3d9;border-radius:12px;padding:30px;box-shadow:0 8px 22px #19362d0b}.diagnosis-preview>span{font-size:11px;letter-spacing:.14em;color:#648774;font-weight:700}.diagnosis-preview p{margin:0;padding:14px 0;border-bottom:1px solid #eaeee7;font-size:19px;font-weight:600}.diagnosis-preview small{display:block;margin-top:20px;color:#66736c;line-height:1.7}
.parcel{background:#f8f7f2}.parcel-steps{display:grid;gap:10px}.parcel-steps>div{display:grid;grid-template-columns:36px 1fr;gap:2px 14px;align-items:start;padding:17px 20px;background:#fff;border:1px solid #e2e4de;border-radius:9px}.parcel-steps span{grid-row:span 2;color:#51745f;font-weight:700;font-size:15px}.parcel-steps strong{font-size:16px}.parcel-steps small{font-size:13px;color:#6f756c;line-height:1.6}
.parcel-actions{align-items:center}.parcel-actions .diagnosis-cta{margin-top:0}.parcel-secondary{color:#245a42!important;border:1px solid #aac1b0;border-radius:8px;padding:14px 18px;text-decoration:none;font-weight:700}
</style>