---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JournalList from '../../components/JournalList.astro';
import { SERIES, seriesEntries } from '../../lib/series';
import { GROUPS, groupOf, publishedJournal } from '../../lib/journalGroups';

// 발행된 일지 (draft 제외 + 예약 발행, 최신순)
// pubDate가 미래인 글은 빌드 시점에 제외 → 시각이 지난 뒤 재빌드되면 나타난다 (.github/workflows/scheduled-publish.yml)
const entries = await publishedJournal();
const logEntries = entries.filter((e) => groupOf(e) === 'log');
const columnEntries = entries.filter((e) => groupOf(e) === 'column');

// 연재
const pf = SERIES['practical-fitting'];
const pfEntries = await seriesEntries('practical-fitting');
const pfRecent = [...pfEntries].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const SHOW = 6;
const tabs = [
  { key: 'log', ...GROUPS.log, count: logEntries.length, anchor: '#log' },
  { key: 'column', ...GROUPS.column, count: columnEntries.length, anchor: '#column' },
  { key: 'series', ...GROUPS.series, count: pfEntries.length, anchor: '#series' },
];
---

<BaseLayout
  title="공작소 일지"
  description="골프채공작소의 작업일지·컬럼·연재. 리샤프팅과 피팅 작업 기록, 샤프트·헤드 이야기, 새로 쓰는 『실제적인 클럽피팅』을 올립니다."
  schemaType="CollectionPage"
  keywords="공작소 일지, 골프채공작소 작업일지, 클럽피팅 일지, 샤프트 교체 사례, 샤프트 리뷰, 실제적인 클럽피팅 연재, 채기웅"
>

  <section class="page-hero journal-hero">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">JOURNAL · 공작소 일지</div>
      <h1>공작소 일지</h1>
      <p class="page-hero-subtitle">
        골프채공작소의 작업 기록과 생각, 그리고 연재를 함께 올립니다.
      </p>

      <nav class="jgroups" aria-label="일지 묶음">
        {tabs.map((t) => (
          <a href={t.anchor} class="jgroup">
            <span class="jgroup-en">{t.en}</span>
            <span class="jgroup-name">{t.name}</span>
            <span class="jgroup-count">{t.count}편</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  {entries.length === 0 ? (
    <section class="section">
      <div class="section-content-narrow">
        <div class="empty-state">
          <p class="empty-icon">📝</p>
          <h2>곧 첫 글이 올라옵니다</h2>
          <p class="empty-text">
            <strong>네이버 블로그</strong>에서 그동안의 작업 기록을 먼저 보실 수 있습니다.
          </p>
          <a href="https://blog.naver.com/clubmakers" target="_blank" rel="noopener noreferrer" class="empty-cta">
            네이버 블로그에서 보기 ↗
          </a>
        </div>
      </div>
    </section>
  ) : (
    <>
      <!-- 작업일지 -->
      <section class="section jsec" id="log">
        <div class="section-content-narrow">
          <div class="jsec-head">
            <div>
              <p class="section-eyebrow">{GROUPS.log.en} · {GROUPS.log.name}</p>
              <h2 class="jsec-title">작업일지</h2>
              <p class="jsec-lead">{GROUPS.log.lead}</p>
            </div>
            {logEntries.length > SHOW && <a class="jsec-more" href={GROUPS.log.path}>전체 {logEntries.length}편 보기 →</a>}
          </div>
          {logEntries.length ? <JournalList entries={logEntries.slice(0, SHOW)} headingTag="h3" /> : <p class="jsec-empty">첫 작업일지를 준비하고 있습니다.</p>}
          {logEntries.length > SHOW && <a class="jsec-more jsec-more-bottom" href={GROUPS.log.path}>작업일지 전체 보기 →</a>}
        </div>
      </section>

      <!-- 컬럼 -->
      <section class="section jsec jsec-alt" id="column">
        <div class="section-content-narrow">
          <div class="jsec-head">
            <div>
              <p class="section-eyebrow">{GROUPS.column.en} · {GROUPS.column.name}</p>
              <h2 class="jsec-title">컬럼</h2>
              <p class="jsec-lead">{GROUPS.column.lead}</p>
            </div>
            {columnEntries.length > SHOW && <a class="jsec-more" href={GROUPS.column.path}>전체 {columnEntries.length}편 보기 →</a>}
          </div>
          {columnEntries.length ? <JournalList entries={columnEntries.slice(0, SHOW)} headingTag="h3" /> : <p class="jsec-empty">첫 컬럼을 준비하고 있습니다.</p>}
          {columnEntries.length > SHOW && <a class="jsec-more jsec-more-bottom" href={GROUPS.column.path}>컬럼 전체 보기 →</a>}
        </div>
      </section>

      <!-- 연재 -->
      <section class="section jsec" id="series">
        <div class="section-content-narrow">
          <p class="section-eyebrow">{GROUPS.series.en} · {GROUPS.series.name}</p>
          <a href={pf.path} class="series-banner">
            <span class="series-banner-eyebrow">연재</span>
            <span class="series-banner-title">{pf.name}</span>
            <span class="series-banner-lead">{pf.lead}</span>
            <span class="series-banner-foot">
              {pfEntries.length > 0 ? <>지금까지 {pfEntries.length}편</> : <>첫 편 준비 중</>}
              <span class="series-banner-go">연재 모아 보기 →</span>
            </span>
          </a>
          {pfRecent.length > 0 && (
            <div style="margin-top:20px"><JournalList entries={pfRecent} headingTag="h3" /></div>
          )}
        </div>
      </section>
    </>
  )}

  <section class="section section-bg-cream">
    <div class="section-content-narrow">
      <p class="section-eyebrow">ABOUT · 일지에 관하여</p>
      <h2>왜 일지를 쓰나요?</h2>
      <p class="about-body">
        25년간 매일 들어오는 클럽이 다 다르고, 손님의 증상도 다 다릅니다.
        그동안 쌓인 자료가 적지 않은데 — 책에는 핵심 원리가, 케이스 스터디에는 큰 사례가,
        일지에는 그날 그날의 작은 기록이 담깁니다.
      </p>
      <p class="about-body">
        하나의 짧은 글이지만 시간이 지나면 <strong>측정 데이터, 샤프트 강도, 손님의 증상이
        검색 가능한 자료로 누적</strong>됩니다. 비슷한 고민을 가진 분이 검색으로 찾아오실 수 있게요.
      </p>

      <div class="about-formats">
        <h3>일지 형식</h3>
        <ul>
          <li><strong>🔧 작업 일지</strong> — 그날의 작업·측정·진단을 짧게. 증상 → 측정 → 진단 → 처방 4단</li>
          <li><strong>📐 샤프트·헤드 리뷰</strong> — 실측 EI 곡선·CPM·무게·시타 소감. 마케팅이 아닌 측정 데이터 우선</li>
          <li><strong>📊 장비 트렌드</strong> — PGA·KLPGA에서 자주 보이는 샤프트, 신제품, 시장 변화 (분기 1회)</li>
          <li><strong>✍️ 컬럼</strong> — 공작소장의 생각, 제품 이야기, 장비 흐름</li>
          <li><strong>📖 연재</strong> — 새로 쓰는 『실제적인 클럽피팅』. 원고를 처음부터 다시 읽으며 한 편씩 손보아 올립니다</li>
          <li><strong>📏 측정 데이터</strong> — 샤프트별 CPM/EI, 헤드별 MOI/CG. 시간이 갈수록 가치가 커집니다</li>
        </ul>
      </div>
    </div>
  </section>

</BaseLayout>


<style>
  .journal-hero { background: var(--bg-cream); }

  /* 묶음 바로가기 */
  .jgroups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; max-width: 620px; margin-top: .5rem; }
  .jgroup {
    display: flex; flex-direction: column; gap: 2px; padding: 14px 16px; border-radius: 8px;
    background: var(--bg); border: 1px solid var(--line); text-decoration: none; color: var(--ink); transition: border-color .2s, transform .2s;
  }
  .jgroup:hover { border-color: var(--green); transform: translateY(-2px); }
  .jgroup-en { font-size: 10.5px; letter-spacing: .14em; color: var(--gold); font-weight: 700; }
  .jgroup-name { font-family: var(--font-serif); font-size: 19px; font-weight: 700; }
  .jgroup-count { font-size: 12.5px; color: var(--grey); font-variant-numeric: tabular-nums; }

  /* 묶음 섹션 */
  .jsec { scroll-margin-top: 80px; }
  .jsec-alt { background: var(--bg-soft); }
  .jsec-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px 24px; margin-bottom: 20px; }
  .jsec-title { font-family: var(--font-serif); font-size: 26px; font-weight: 700; color: var(--ink); margin: 0 0 8px; }
  .jsec-lead { font-size: 14.5px; line-height: 1.8; color: var(--ink-2); margin: 0; max-width: 560px; }
  .jsec-more { font-size: 14px; font-weight: 600; color: var(--green); text-decoration: none; white-space: nowrap; }
  .jsec-more:hover { text-decoration: underline; }
  .jsec-more-bottom { display: inline-block; margin-top: 18px; }
  .jsec-empty { padding: 28px 20px; text-align: center; border: 1px dashed var(--line); border-radius: 8px; color: var(--grey); font-size: 14px; margin: 0; }
  @media (max-width: 560px) { .jgroups { gap: 6px; } .jgroup { padding: 10px 10px; } .jgroup-name { font-size: 16px; } }

  /* 연재 배너 */
  .series-banner-wrap { padding-bottom: 0; }
  .series-banner {
    display: flex; flex-direction: column; gap: 8px;
    padding: 24px 26px; border-radius: 10px; text-decoration: none; color: inherit;
    background: var(--green); color: #F4F1E8; transition: transform .2s;
  }
  .series-banner:hover { transform: translateY(-2px); }
  .series-banner-eyebrow { font-size: 11px; letter-spacing: .16em; font-weight: 700; color: var(--gold); }
  .series-banner-title { font-family: var(--font-serif); font-size: 22px; font-weight: 700; line-height: 1.4; }
  .series-banner-lead { font-size: 14px; line-height: 1.8; opacity: .85; }
  .series-banner-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; font-size: 13px; opacity: .9; margin-top: 4px; }
  .series-banner-go { color: var(--gold); font-weight: 600; }
  .page-hero h1 { margin-bottom: 1.5rem; }
  .page-hero-subtitle { margin-bottom: 2.5rem; }

  /* 통계 행 */
  .journal-stats {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 18px 28px;
    margin-top: 0.5rem;
  }
  .stat { text-align: center; }
  .stat-num {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 700;
    color: var(--green);
    line-height: 1;
    margin: 0 0 4px;
  }
  .stat-label {
    font-size: 11px;
    color: var(--grey);
    margin: 0;
    line-height: 1.4;
  }
  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--line);
  }

  /* 빈 상태 */
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background: var(--bg-soft);
    border-radius: 8px;
    border: 1px dashed var(--line);
  }
  .empty-icon {
    font-size: 48px;
    margin-bottom: 16px;
  }
  .empty-state h2 {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 16px;
  }
  .empty-text {
    font-size: 15px;
    line-height: 1.85;
    color: var(--ink-2);
    margin-bottom: 14px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }
  .empty-text strong {
    color: var(--ink);
    font-weight: 600;
  }
  .empty-cta {
    display: inline-block;
    background: #03C75A;
    color: white;
    padding: 12px 24px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    margin-top: 8px;
    transition: opacity 0.2s, transform 0.2s;
  }
  .empty-cta:hover {
    opacity: 0.9;
    transform: translateX(2px);
  }

  /* 일지 카드 리스트 */
  .journal-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 28px;
  }
  .journal-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 24px 28px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    display: block;
  }
  .journal-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(15, 41, 34, 0.08);
    border-color: var(--green);
  }

  .journal-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }
  .journal-cat {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 4px 10px;
    border-radius: 100px;
  }
  .journal-cat-log    { background: rgba(15, 41, 34, 0.08); color: var(--green); }
  .journal-cat-review { background: rgba(184, 152, 92, 0.15); color: var(--gold); }
  .journal-cat-trends { background: rgba(70, 110, 200, 0.10); color: #2E5BBA; }
  .journal-cat-series { background: rgba(184, 152, 92, 0.16); color: #8A6A2E; }
  .journal-cat-data   { background: rgba(120, 60, 60, 0.10); color: #804040; }

  .journal-club {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--grey);
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 100px;
  }
  .journal-date {
    font-size: 12px;
    color: var(--grey);
    margin-left: auto;
  }

  .journal-title {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.4;
    margin: 0 0 8px;
  }
  .journal-desc {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--ink-2);
    margin: 0 0 12px;
  }
  .journal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 12px;
  }
  .journal-tag {
    font-size: 11.5px;
    color: var(--grey);
    padding: 3px 8px;
    background: var(--bg-soft);
    border-radius: 100px;
  }
  .journal-arrow {
    font-size: 13px;
    font-weight: 600;
    color: var(--green);
    letter-spacing: 0.03em;
  }
  .journal-card:hover .journal-arrow {
    color: var(--gold);
  }

  /* About 섹션 */
  .about-body {
    font-size: 16px;
    line-height: 1.85;
    color: var(--ink-2);
    margin-bottom: 18px;
  }
  .about-body strong {
    color: var(--ink);
    font-weight: 600;
  }
  .about-formats {
    margin-top: 28px;
    padding: 24px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .about-formats h3 {
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 14px;
  }
  .about-formats ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .about-formats li {
    padding: 10px 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-2);
    border-bottom: 1px solid var(--line-soft, var(--line));
  }
  .about-formats li:last-child { border-bottom: none; }
  .about-formats strong {
    color: var(--ink);
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .journal-stats { padding: 14px 20px; gap: 18px; }
    .stat-num { font-size: 22px; }
    .journal-card { padding: 20px 22px; }
    .journal-title { font-size: 18px; }
    .journal-meta { gap: 6px; }
    .journal-date { width: 100%; margin-left: 0; }
  }
</style>
