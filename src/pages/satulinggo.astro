    <div class="phrase" id="phrase">이마트 에브리데이</div>
    <div class="hint" id="meaning">억양이 잘 드러나는 말</div>

    <div class="mascotWrap" id="mascotWrap" aria-live="polite">
      <div class="halo"></div>
      <div class="mascot" id="mascot">
        <span class="ear l"></span><span class="ear r"></span>
        <span class="eye l"></span><span class="eye r"></span><span class="mouth"></span>
        <div class="mic"><span class="micHead"></span><span class="micStem"></span><span class="micBase"></span></div>
      </div>
      <div class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
    </div>

    <button class="recordBtn" id="record" type="button">🎙️ 한마디 녹음</button>
    <div class="status" id="status">마이크를 누르고 자연스럽게 말해보세요.</div>

    <div class="kakao" id="kakaoGate">
      <b>카카오톡 안에서는 녹음이 제한될 수 있어요.</b>
      <p>Safari 또는 Chrome으로 열면 바로 녹음할 수 있습니다.</p>
      <div class="subactions">
        <button class="btn dark grow" id="openExternal" type="button">브라우저로 열기</button>
        <button class="btn grow" id="copyExternal" type="button">링크 복사</button>
      </div>
    </div>

    <div class="review" id="review">
      <div class="reviewTitle">내 한마디 🎧</div>
      <audio id="audio" controls></audio>
      <div class="subactions">
        <button class="btn grow" id="retryRecord" type="button">↻ 다시 녹음</button>
        <button class="btn lime grow" id="confirmRecord" type="button">이대로 보내기</button>
      </div>
    </div>

    <div class="invite" id="invite">
      <b>😈 익명 친구에게 공유</b>
      <div class="small" id="inviteText">이 링크로 들어온 친구는 이름 없이 녹음하고 서로 들을 수 있어요.</div>
      <div class="subactions">
        <button class="btn lime grow" id="shareInvite" type="button">💬 카톡·메시지로 공유</button>
        <button class="btn grow" id="copy" type="button">링크 복사</button>
      </div>
    </div>
  </section>

  <section class="social" id="social">
    <div class="socialHead"><h3>익명 친구 녹음</h3><span class="tiny" id="socialCount">0개</span></div>
    <div class="small">녹음은 계속 쌓여요 · 이름은 동물 별명으로 표시 · 자기 녹음 투표 불가</div>
    <div class="rankTitle">🏆 베스트 3</div>
    <div id="bestList"></div>
    <details class="moreCard" id="moreCard"><summary id="moreSummary">나머지 녹음 보기</summary><div class="moreInner" id="moreList"></div></details>
    <div class="result" id="result">
      <h3 id="resultTitle">투표 시작 😂</h3>
      <p id="resultText">들어보고 제일 어울리는 반응을 눌러주세요.</p>
      <div class="subactions">
        <button class="btn grow" id="share" type="button">📤 결과 공유</button>
        <button class="btn lime grow" id="counter" type="button">😈 니도 해봐라</button>
      </div>
    </div>
  </section>

  <section class="chooser" id="chooser">
    <div class="subactions">
      <button class="btn grow" id="another" type="button">🎲 다른 한마디</button>
      <button class="btn dark grow" id="custom" type="button">✏️ 직접 던지기</button>
    </div>
    <button class="btn suggest" id="suggest" type="button">📍 로컬인 도전 문장 제보</button>
  </section>

  <div class="footer">사투링고 · 낭만공작소</div>
</main>

<script>
var lessons=[["이마트 에브리데이","억양이 잘 드러나는 말"],["블루베리 스무디","억양이 잘 드러나는 말"],["어디까지 올라가는거에요","억양이 잘 드러나는 문장"],["e의 2승 이마트","발음과 억양 도전"],["거 우예됐노","경상도 도전 · 자연스럽게 읽어보세요"],["니 여기 짤리나? 아 안 짤리나?","경상도 도전 · 자연스럽게 읽어보세요"],["짜달시리 뭐","경상도 도전 · 자연스럽게 읽어보세요"],["오늘 헐트라","경상도 도전 · 자연스럽게 읽어보세요"],["잘 쓰까무라","경상도 도전 · 자연스럽게 읽어보세요"],["요 마 스근하네","경상도 도전 · 자연스럽게 읽어보세요"],["확마 뿔라뿌라","경상도 도전 · 자연스럽게 읽어보세요"],["하모예","경상도 도전 · 자연스럽게 읽어보세요"],["마 니 와 이라노","경상도 도전 · 자연스럽게 읽어보세요"],["니 지금 뭐하노","경상도 도전 · 자연스럽게 읽어보세요"],["밥 뭇나","경상도 도전 · 자연스럽게 읽어보세요"],["어데 가노","경상도 도전 · 자연스럽게 읽어보세요"],["퍼뜩 온나","경상도 도전 · 자연스럽게 읽어보세요"],["가가 가가?","경상도 도전 · 자연스럽게 읽어보세요"],["와 그라노","경상도 도전 · 자연스럽게 읽어보세요"],["쫌 단디 해라","경상도 도전 · 자연스럽게 읽어보세요"],["고마 해라 마","경상도 도전 · 자연스럽게 읽어보세요"],["쌔리 함 해뿌라","경상도 도전 · 자연스럽게 읽어보세요"],["니 내 아나","경상도 도전 · 자연스럽게 읽어보세요"],["맞제, 그자?","경상도 도전 · 자연스럽게 읽어보세요"],["이게 맞나 아이가","경상도 도전 · 자연스럽게 읽어보세요"],["와 이리 늦었노","경상도 도전 · 자연스럽게 읽어보세요"]];
var n=0,rec=null,chunks=[],audioBlob=null,done=false,missionId=null,pollTimer=null,recordTimer=null;
var rid=(crypto.randomUUID?crypto.randomUUID():Date.now()+"-"+Math.random().toString(16).slice(2));
var anonId=localStorage.getItem("satulinggo_anon_id")||rid;localStorage.setItem("satulinggo_anon_id",anonId);
var isKakao=/KAKAOTALK/i.test(navigator.userAgent),isAndroid=/Android/i.test(navigator.userAgent);
function $(s){return document.querySelector(s)}
function currentPhrase(){return $("#phrase").textContent.trim()}
function setProgress(step){document.querySelectorAll(".dot").forEach(function(d,i){d.classList.toggle("on",i===step)})}
function setRecordingUI(on){$("#mascot").classList.toggle("listening",on);$("#mascotWrap").classList.toggle("recording",on);$("#record").classList.toggle("rec",on)}
function speak(t){if(!("speechSynthesis" in window))return;var u=new SpeechSynthesisUtterance(t);u.lang="ko-KR";u.rate=.82;speechSynthesis.cancel();speechSynthesis.speak(u)}
function copyText(t){if(navigator.clipboard&&window.isSecureContext)return navigator.clipboard.writeText(t);var x=document.createElement("textarea");x.value=t;x.style.position="fixed";x.style.opacity="0";document.body.appendChild(x);x.select();document.execCommand("copy");x.remove();return Promise.resolve()}
function load(x){$("#phrase").textContent=x[0];$("#meaning").textContent=x[1];$("#review").style.display="none";$("#invite").style.display="none";$("#social").style.display="none";$("#result").style.display="none";$("#record").style.display="flex";$("#record").disabled=false;$("#record").textContent="🎙️ 한마디 녹음";$("#status").textContent="마이크를 누르고 자연스럽게 말해보세요.";$("#confirmRecord").disabled=false;$("#confirmRecord").textContent="이대로 보내기";audioBlob=null;done=false;missionId=null;setProgress(0)}
async function createMission(){if(missionId)return missionId;$("#status").textContent="미션 만드는 중…";var r=await fetch("/api/satulinggo/create",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({phrase:currentPhrase(),senderId:anonId})});var j=await r.json().catch(function(){return{}});if(!r.ok)throw new Error(j.error||"미션 생성 실패");missionId=j.id;$("#invite").style.display="block";$("#inviteText").textContent="이 링크로 들어온 친구는 이름 없이 녹음하고, 들어온 녹음은 여기서 함께 들을 수 있어요.";startPolling();return missionId}
function missionUrl(){return location.origin+"/satulinggo/?m="+encodeURIComponent(missionId)}
async function shareText(text,title,url){if(navigator.share){try{await navigator.share({title:title,text:text,url:url});return}catch(e){if(e.name==="AbortError")return}}await copyText((text+" "+url).trim());alert("공유 문구를 복사했습니다.")}
async function refreshMission(){if(!missionId)return;var r=await fetch("/api/satulinggo/mission/"+encodeURIComponent(missionId),{cache:"no-store"});if(!r.ok)return;var j=await r.json();renderRecordings(j.recordings||[])}
function startPolling(){if(pollTimer)clearInterval(pollTimer);refreshMission();pollTimer=setInterval(refreshMission,3000)}
function animalName(id,index){
  var animals=["수달","해달","고래","돌고래","문어","복어","망둥어","상어","가오리","펭귄","여우","너구리","두더지","고슴도치","다람쥐","토끼","알파카","카피바라","판다","코알라","수리부엉이","참새","까치","오리","거북이","도마뱀","표범","사슴","물개","바다사자"];
  var h=0,s=String(id||index);for(var i=0;i<s.length;i++)h=(h*31+s.charCodeAt(i))>>>0;
  return animals[h%animals.length];
}
function scoreOf(x){return Number(x.votes.laugh||0)+Number(x.votes.fire||0)+Number(x.votes.good||0)}
function recordingCard(x,rank){
  var me=x.participantId===anonId,label=me?"내 녹음":animalName(x.participantId,x.index),d=document.createElement("div");
  d.className="person";
  var rankText=rank?" · "+rank+"위":"";
  d.innerHTML='<div class="personHead"><span class="avatar">'+(me?"🎧":"🐾")+'</span><div class="info"><div class="name">'+label+rankText+'</div><div class="small">'+(me?"친구에게는 동물 별명으로 보여요":"익명 동물 별명")+'</div></div><div class="score">반응 '+scoreOf(x)+'</div></div><audio controls preload="metadata" src="'+x.audioUrl+'"></audio>'+(me?'<button class="deleteMine" data-delete="'+x.id+'">내 녹음 지우기</button>':'<div class="votes"><button class="vote" data-id="'+x.id+'" data-v="😂">😂 '+x.votes.laugh+'</button><button class="vote" data-id="'+x.id+'" data-v="🔥">🔥 '+x.votes.fire+'</button><button class="vote" data-id="'+x.id+'" data-v="👍">👍 '+x.votes.good+'</button></div>');
  return d;
}
function renderRecordings(list){
  $("#social").style.display="block";
  $("#socialCount").textContent=list.length+"개";
  var best=$("#bestList"),more=$("#moreList"),details=$("#moreCard");
  best.innerHTML="";more.innerHTML="";
  var sorted=list.slice().sort(function(a,b){var ds=scoreOf(b)-scoreOf(a);if(ds)return ds;return Number(b.createdAt||0)-Number(a.createdAt||0)});
  var top=sorted.slice(0,3),rest=sorted.slice(3);
  if(!top.length){var empty=document.createElement("div");empty.className="slot";empty.textContent="아직 녹음이 없습니다. 첫 목소리를 남겨보세요.";best.appendChild(empty)}
  top.forEach(function(x,i){best.appendChild(recordingCard(x,i+1))});
  rest.forEach(function(x){more.appendChild(recordingCard(x,0))});
  details.style.display=rest.length?"block":"none";
  $("#moreSummary").textContent="나머지 녹음 "+rest.length+"개 보기";
  document.querySelectorAll(".vote").forEach(function(b){b.onclick=vote});
  document.querySelectorAll("[data-delete]").forEach(function(b){b.onclick=deleteMine});
  var totalVotes=list.reduce(function(sum,x){return sum+scoreOf(x)},0);
  if(totalVotes>0){$("#result").style.display="block";$("#resultTitle").textContent="베스트가 바뀌고 있어요 😂"}else $("#result").style.display="none"
}
async function deleteMine(e){
  var id=e.currentTarget.dataset.delete;
  if(!confirm("내가 올린 이 녹음을 지울까요?"))return;
  e.currentTarget.disabled=true;
  var r=await fetch("/api/satulinggo/recording/"+encodeURIComponent(id),{method:"DELETE",headers:{"content-type":"application/json"},body:JSON.stringify({participantId:anonId})});
  var j=await r.json().catch(function(){return{}});
  if(!r.ok){alert(j.error||"삭제 실패");e.currentTarget.disabled=false;return}
  done=false;audioBlob=null;
  $("#record").style.display="flex";$("#record").disabled=false;$("#record").textContent="🎙️ 다시 녹음";
  $("#review").style.display="none";$("#status").textContent="삭제했습니다. 원하면 다시 녹음할 수 있어요.";setProgress(0);
  await refreshMission();
}
async function vote(e){var b=e.currentTarget;b.disabled=true;var r=await fetch("/api/satulinggo/vote/"+encodeURIComponent(b.dataset.id),{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({voterId:anonId,reaction:b.dataset.v})});var j=await r.json().catch(function(){return{}});if(!r.ok){alert(j.error||"투표 실패");b.disabled=false;return}await refreshMission()}
function showKakaoGate(){$("#kakaoGate").style.display="block";$("#status").textContent="카카오톡에서는 외부 브라우저로 열어주세요."}
async function beginRecording(){if(done)return;if(isKakao){showKakaoGate();return}if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia||!("MediaRecorder" in window)){$("#status").textContent="이 브라우저에서는 녹음을 지원하지 않습니다. Safari/Chrome에서 열어주세요.";return}try{var stream=await navigator.mediaDevices.getUserMedia({audio:true});chunks=[];var opts={};if(MediaRecorder.isTypeSupported&&MediaRecorder.isTypeSupported("audio/mp4"))opts.mimeType="audio/mp4";else if(MediaRecorder.isTypeSupported&&MediaRecorder.isTypeSupported("audio/webm"))opts.mimeType="audio/webm";rec=new MediaRecorder(stream,opts);rec.ondataavailable=function(e){if(e.data&&e.data.size)chunks.push(e.data)};rec.onstop=function(){stream.getTracks().forEach(function(t){t.stop()});clearTimeout(recordTimer);setRecordingUI(false);audioBlob=new Blob(chunks,{type:rec.mimeType||"audio/mp4"});$("#audio").src=URL.createObjectURL(audioBlob);$("#review").style.display="block";$("#record").style.display="none";$("#status").textContent="먼저 들어보고 마음에 안 들면 다시 녹음하세요.";setProgress(1)};rec.start();setRecordingUI(true);$("#record").textContent="■ 녹음 중 · 누르면 멈춤";$("#status").textContent="듣고 있어요… 최대 7초";recordTimer=setTimeout(function(){if(rec&&rec.state==="recording")rec.stop()},7000)}catch(e){setRecordingUI(false);$("#status").textContent="마이크 권한을 허용해주세요."}}
$("#record").onclick=function(){if(rec&&rec.state==="recording"){rec.stop();return}beginRecording()};
$("#example").onclick=function(){speak(currentPhrase())};
$("#another").onclick=function(){n=(n+1)%lessons.length;load(lessons[n])};
$("#retryRecord").onclick=function(){if(done)return;audioBlob=null;$("#audio").removeAttribute("src");$("#audio").load();$("#review").style.display="none";$("#record").style.display="flex";$("#record").textContent="🎙️ 다시 녹음";$("#status").textContent="다시 한번 해보세요.";setProgress(0)};
$("#confirmRecord").onclick=async function(){if(!audioBlob||done)return;try{$("#confirmRecord").disabled=true;$("#status").textContent="익명으로 보내는 중…";if(!missionId)await createMission();var f=new FormData(),ext=(audioBlob.type||"").includes("mp4")?"m4a":"webm";f.append("participantId",anonId);f.append("audio",audioBlob,"voice."+ext);var r=await fetch("/api/satulinggo/upload/"+encodeURIComponent(missionId),{method:"POST",body:f});var j=await r.json().catch(function(){return{}});if(!r.ok)throw new Error(j.error||"전송 실패");done=true;$("#review").style.display="none";$("#record").style.display="none";$("#from").textContent="🎧 익명 듣기 · 투표";$("#meaning").textContent="친구들 목소리가 들어오면 바로 나타나요.";$("#status").textContent="전송 완료! 내 녹음을 다시 듣거나 익명 친구에게 공유해보세요.";$("#invite").style.display="block";$("#social").style.display="block";setProgress(2);await refreshMission();$("#invite").scrollIntoView({behavior:"smooth",block:"nearest"})}catch(e){$("#confirmRecord").disabled=false;$("#status").textContent=e.message}};

$("#shareInvite").onclick=async function(){try{await createMission();await shareText("😈 사투링고 미션 ‘"+currentPhrase()+"’ 한번 해봐라!","사투링고 미션",missionUrl())}catch(e){$("#status").textContent=e.message}};
$("#copy").onclick=async function(){try{await createMission();await copyText(missionUrl());alert("미션 링크를 복사했습니다.")}catch(e){$("#status").textContent=e.message}};
$("#share").onclick=function(){shareText("😂 사투링고 결과 ‘"+currentPhrase()+"’ 익명 친구들 투표 중!","사투링고 결과",missionUrl())};
$("#counter").onclick=function(){location.href="/satulinggo/"};
$("#custom").onclick=function(){var x=prompt("친구에게 시킬 한마디");if(x&&x.trim()){lessons.push([x.trim(),"직접 만든 도전 문장"]);n=lessons.length-1;load(lessons[n])}};
$("#suggest").onclick=async function(){var region=prompt("어느 지역 말투예요?\n예: 부산, 대구, 광주, 충청");if(!region)return;var phrase=prompt("로컬인이 알 만한 도전 문장을 적어주세요.");if(!phrase)return;var r=await fetch("/api/satulinggo/suggest",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({region:region,phrase:phrase,submitterId:anonId})});var j=await r.json().catch(function(){return{}});if(r.ok)alert("제보 완료! 로컬 문장 후보로 모아둘게요 🙌");else alert(j.error||"제보에 실패했습니다.")};
$("#openExternal").onclick=function(){var u=location.href;if(isAndroid){location.href="intent://"+u.replace(/^https?:\/\//,"")+"#Intent;scheme=https;package=com.android.chrome;end"}else{copyText(u);alert("링크를 복사했습니다. 카카오톡의 ⋯ 메뉴에서 ‘다른 브라우저로 열기’ 또는 Safari로 열어주세요.")}};
$("#copyExternal").onclick=async function(){await copyText(location.href);alert("링크를 복사했습니다.")};
if(isKakao)showKakaoGate();
(async function(){var m=new URLSearchParams(location.search).get("m");if(!m)return;missionId=m;$("#from").textContent="😈 친구가 던진 한마디";$("#meaning").textContent="친구가 이 한마디를 시켰어요.";$("#chooser").style.display="none";try{var r=await fetch("/api/satulinggo/mission/"+encodeURIComponent(m),{cache:"no-store"}),j=await r.json();if(!r.ok)throw new Error(j.error||"미션을 찾을 수 없습니다.");$("#phrase").textContent=j.mission.phrase;renderRecordings(j.recordings||[]);var mine=(j.recordings||[]).find(function(x){return x.participantId===anonId});if(mine){done=true;$("#record").style.display="none";$("#review").style.display="none";$("#invite").style.display="block";$("#from").textContent="🎧 익명 듣기 · 투표";$("#meaning").textContent="이미 녹음했어요. 다른 친구 목소리를 들어보세요.";$("#status").textContent="다른 익명 친구 녹음을 듣고 투표해보세요.";setProgress(2)}else{$("#status").textContent="마이크를 누르고 한마디 해보세요."}startPolling()}catch(e){$("#status").textContent=e.message}})();
</script>
</body>
</html>