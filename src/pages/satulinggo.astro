<html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>사투링고</title>
<style>
body{margin:0;background:#f4f1e9;color:#151515;font-family:-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Noto Sans KR",sans-serif}.app{max-width:520px;margin:auto;padding:16px}.top{display:flex;justify-content:space-between;padding:8px 2px 16px}.logo{font-size:26px;font-weight:900;letter-spacing:-2px}.brand{font-size:10px;font-weight:900}.hero,.card{border-radius:24px;margin-bottom:12px}.hero{background:#151515;color:white;padding:22px}.hero b{color:#caff3d;font-size:11px}.hero h1{font-size:29px;line-height:1.1;letter-spacing:-2px}.hero p{color:#bbb;font-size:13px}.card{background:white;border:1px solid #ddd9d0;padding:18px}.pill{background:#f0eee7;border-radius:20px;padding:7px 10px;font-size:12px;font-weight:900}.phrase{font-size:32px;font-weight:950;letter-spacing:-2px;margin:20px 0 8px}.meaning{font-size:13px;color:#777;margin-bottom:14px}.row{display:flex;gap:8px}.btn{border:0;border-radius:15px;padding:13px 15px;font-weight:900}.dark{background:#151515;color:white}.green{background:#caff3d}.light{background:#eeeae1}.record{width:100%;margin-top:9px;font-size:16px}.status{font-size:12px;color:#888;margin-top:8px;min-height:18px}.mine,.friends,.invite,.result{display:none}.mine{background:#f7f5ef;border-radius:16px;padding:13px;margin-top:12px}.mine audio,.person audio{width:100%;margin-top:8px}.friends h3{margin-bottom:5px}.person{border-top:1px solid #eee;padding:12px 0}.personHead{display:flex;align-items:center;gap:7px}.info{flex:1}.name{font-weight:900;font-size:13px}.small{font-size:11px;color:#999}.votes{display:flex;gap:5px;margin-top:8px}.vote{border:1px solid #ddd;background:white;border-radius:10px;padding:7px 10px;font-weight:800}.vote:disabled{opacity:.45}.selected{background:#151515!important;color:white}.result{background:#151515;color:white;border-radius:17px;padding:14px;margin-top:10px}.share{width:100%;margin-top:8px}.footer{text-align:center;color:#999;font-size:10px;padding:10px}.waiting{padding:12px 0;color:#777;font-size:13px}.count{font-size:11px;color:#777;margin-left:3px}
</style></head><body><main class="app">
<div class="top"><div class="logo">사투링고</div><div class="brand">낭만공작소</div></div>
<section class="hero"><b>JUST FOR FUN</b><h1>한마디 던지고<br>친구 목소리 들어보자.</h1><p>설치도 가입도 필요 없음.<br>듣고 · 녹음하고 · 웃고 · 바로 공유.</p></section>
<section class="card"><span class="pill" id="from">🎙️ 오늘의 한마디</span><div class="phrase" id="phrase">단디 입으래이.</div><div class="meaning" id="meaning">표준어: 옷 따뜻하게 잘 챙겨 입어.</div>
<div class="row"><button class="btn light" id="example">▶️ 예시 듣기</button><button class="btn dark" id="send">😈 친구한테 시키기</button></div>
<button class="btn green record" id="record">🎙️ 한 번만 녹음</button><div class="status" id="status">녹음은 한 번만 가능합니다.</div>
<div class="mine" id="mine"><b>내 녹음</b><audio id="audio" controls></audio></div>
<div class="friends" id="friends"><h3>익명 친구 녹음</h3><div class="small">최대 3명 · 서로 이름 비공개 · 자기 녹음 투표 불가</div><div id="friendList" class="waiting">아직 녹음이 없습니다.</div>
<div class="result" id="result"><h2 id="resultTitle">투표 중 😂🔥👍</h2><p id="resultText">친구들의 반응이 모이고 있습니다.</p><button class="btn light share" id="share">📤 결과 공유</button><button class="btn green share" id="counter">😈 니도 해봐라</button></div></div>
<div class="invite" id="invite"><b>😈 바로 던지기</b><p class="small" id="inviteText">카톡으로 링크 하나만 보내세요.</p><div class="row"><button class="btn green" id="shareInvite">💬 카톡으로 보내기</button><button class="btn light" id="copy">링크 복사</button></div></div></section>
<section class="card" id="chooser"><div class="row"><button class="btn light" id="another" style="flex:1">🎲 다른 한마디</button><button class="btn dark" id="custom" style="flex:1">✏️ 직접 던지기</button></div><button class="btn green" id="suggest" style="width:100%;margin-top:9px">📍 로컬인 도전 문장 제보</button><div class="small" style="margin-top:7px">부산·대구·광주·충청 등 로컬이 아는 진짜 걸리는 문장을 받아요.</div></section>
<div class="footer">사투링고 · 낭만공작소</div></main>
<script>
var lessons=[["이마트 에브리데이","억양이 잘 드러나는 말"],["블루베리 스무디","억양이 잘 드러나는 말"],["어디까지 올라가는거에요","억양이 잘 드러나는 문장"],["e의 2승 이마트","발음과 억양 도전"]],n=0,rec,chunks=[],done=false,audioBlob=null,missionId=null,pollTimer=null;
var anonId=localStorage.getItem("satulinggo_anon_id")||crypto.randomUUID();localStorage.setItem("satulinggo_anon_id",anonId);
function $(x){return document.querySelector(x)}
function speak(t){var u=new SpeechSynthesisUtterance(t);u.lang="ko-KR";u.rate=.78;speechSynthesis.cancel();speechSynthesis.speak(u)}
function currentPhrase(){return $("#phrase").textContent.trim()}
function load(x){$("#phrase").textContent=x[0];$("#meaning").textContent="표준어: "+x[1];$("#friends").style.display="none";$("#result").style.display="none";$("#invite").style.display="none";$("#mine").style.display="none";$("#record").disabled=false;$("#record").textContent="🎙️ 한 번만 녹음";$("#status").textContent="녹음은 한 번만 가능합니다.";done=false;audioBlob=null;missionId=null}
async function createMission(){if(missionId)return missionId;$("#status").textContent="미션 만드는 중…";var r=await fetch("/api/satulinggo/create",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({phrase:currentPhrase(),senderId:anonId})});var j=await r.json();if(!r.ok)throw new Error(j.error||"미션 생성 실패");missionId=j.id;$("#invite").style.display="block";$("#friends").style.display="block";$("#inviteText").textContent="친구 녹음이 들어오면 이 화면에 자동으로 나타납니다.";$("#status").textContent="미션 생성 완료. 친구에게 링크를 보내세요.";startPolling();return missionId}
function missionUrl(){return location.origin+"/satulinggo/?m="+encodeURIComponent(missionId)}
async function shareText(t,title,url){if(navigator.share){try{await navigator.share({title:title,text:t,url:url})}catch(e){}}else{await navigator.clipboard.writeText((t+" "+url).trim());alert("공유 문구를 복사했습니다.")}}
async function refreshMission(){if(!missionId)return;var r=await fetch("/api/satulinggo/mission/"+encodeURIComponent(missionId),{cache:"no-store"});if(!r.ok)return;var j=await r.json();renderRecordings(j.recordings||[])}
function startPolling(){if(pollTimer)clearInterval(pollTimer);refreshMission();pollTimer=setInterval(refreshMission,3000)}
function renderRecordings(list){$("#friends").style.display="block";var box=$("#friendList");if(!list.length){box.className="waiting";box.textContent="친구 녹음 기다리는 중…";$("#result").style.display="none";return}box.className="";box.innerHTML="";var totalVotes=0;list.forEach(function(x){totalVotes+=Number(x.votes.laugh||0)+Number(x.votes.fire||0)+Number(x.votes.good||0);var me=x.participantId===anonId;var d=document.createElement("div");d.className="person";d.innerHTML='<div class="personHead"><div>🎙️</div><div class="info"><div class="name">'+(me?"내 녹음":"익명 친구 "+["①","②","③"][x.index-1])+'</div><div class="small">'+(me?"본인 녹음 · 투표 불가":"이름 비공개")+'</div></div></div><audio controls preload="none" src="'+x.audioUrl+'"></audio><div class="votes"><button class="vote" data-id="'+x.id+'" data-v="😂" '+(me?"disabled":"")+' >😂 <span class="count">'+x.votes.laugh+'</span></button><button class="vote" data-id="'+x.id+'" data-v="🔥" '+(me?"disabled":"")+' >🔥 <span class="count">'+x.votes.fire+'</span></button><button class="vote" data-id="'+x.id+'" data-v="👍" '+(me?"disabled":"")+' >👍 <span class="count">'+x.votes.good+'</span></button></div>';box.appendChild(d)});box.querySelectorAll(".vote").forEach(function(b){b.onclick=vote});if(list.length===3||totalVotes>0){$("#result").style.display="block";$("#resultTitle").textContent=list.length===3?"세 명 다 왔다 😂":"투표가 시작됐다 😂";$("#resultText").textContent="익명으로 듣고 😂 🔥 👍 중 하나를 눌러주세요."}}
async function vote(e){var b=e.currentTarget,id=b.dataset.id,reaction=b.dataset.v;b.disabled=true;var r=await fetch("/api/satulinggo/vote/"+encodeURIComponent(id),{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({voterId:anonId,reaction:reaction})});var j=await r.json().catch(function(){return{}});if(!r.ok){alert(j.error||"투표 실패");b.disabled=false;return}await refreshMission()}
$("#example").onclick=function(){speak(currentPhrase())};$("#another").onclick=function(){n=(n+1)%lessons.length;load(lessons[n])};$("#send").onclick=async function(){try{await createMission();$("#invite").scrollIntoView({behavior:"smooth",block:"nearest"})}catch(e){$("#status").textContent=e.message}};
$("#record").onclick=async function(){if(done)return;try{var s=await navigator.mediaDevices.getUserMedia({audio:true});chunks=[];rec=new MediaRecorder(s);rec.ondataavailable=function(e){if(e.data.size)chunks.push(e.data)};rec.onstop=async function(){s.getTracks().forEach(function(t){t.stop()});audioBlob=new Blob(chunks,{type:rec.mimeType||"audio/webm"});$("#audio").src=URL.createObjectURL(audioBlob);$("#mine").style.display="block";$("#record").disabled=true;$("#record").textContent="✓ 녹음 완료";done=true;if(missionId){$("#status").textContent="녹음 보내는 중…";var f=new FormData();f.append("participantId",anonId);f.append("audio",audioBlob,"voice.webm");var r=await fetch("/api/satulinggo/upload/"+encodeURIComponent(missionId),{method:"POST",body:f});var j=await r.json().catch(function(){return{}});if(r.ok){$("#status").textContent="전송 완료! 다른 친구 녹음도 여기서 들을 수 있습니다.";await refreshMission()}else{$("#status").textContent=j.error||"전송 실패"}}else{$("#status").textContent="녹음 완료. 친구한테 시키기를 눌러 미션을 만드세요.";$("#invite").style.display="block"}};rec.start();$("#record").textContent="■ 녹음 중…";setTimeout(function(){if(rec.state==="recording")rec.stop()},7000)}catch(e){$("#status").textContent="마이크 권한을 허용해주세요."}};
$("#shareInvite").onclick=async function(){try{await createMission();shareText("😈 사투링고 미션 “"+currentPhrase()+"” 한번 해봐라!","사투링고 미션",missionUrl())}catch(e){$("#status").textContent=e.message}};
$("#copy").onclick=async function(){try{await createMission();await navigator.clipboard.writeText(missionUrl());alert("미션 링크를 복사했습니다.")}catch(e){$("#status").textContent=e.message}};
$("#share").onclick=function(){shareText("😂 사투링고 결과 “"+currentPhrase()+"” 익명 친구들 투표 중!","사투링고 결과",missionUrl())};$("#counter").onclick=function(){$("#send").click()};$("#custom").onclick=function(){var x=prompt("친구에게 시킬 한마디");if(x){lessons.push([x,"직접 만든 미션"]);n=lessons.length-1;load(lessons[n])}};$("#suggest").onclick=async function(){var region=prompt("어느 지역 말투예요?\n예: 부산, 대구, 광주, 충청");if(!region)return;var phrase=prompt("로컬인이 알 만한 도전 문장을 적어주세요.");if(!phrase)return;var r=await fetch("/api/satulinggo/suggest",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({region:region,phrase:phrase,submitterId:anonId})});var j=await r.json().catch(function(){return{}});if(r.ok)alert("제보 완료! 로컬 문장 후보로 모아둘게요 🙌");else alert(j.error||"제보에 실패했습니다.")};
(async function(){var q=new URLSearchParams(location.search),m=q.get("m");if(!m)return;missionId=m;$("#from").textContent="😈 친구가 던짐";$("#meaning").textContent="친구가 시킨 한마디입니다.";$("#send").style.display="none";$("#chooser").style.display="none";$("#invite").style.display="none";$("#friends").style.display="block";try{var r=await fetch("/api/satulinggo/mission/"+encodeURIComponent(m));var j=await r.json();if(!r.ok)throw new Error(j.error||"미션을 찾을 수 없습니다.");$("#phrase").textContent=j.mission.phrase;renderRecordings(j.recordings||[]);var mine=(j.recordings||[]).find(function(x){return x.participantId===anonId});if(mine){$("#record").disabled=true;$("#record").textContent="✓ 이미 녹음 완료";$("#status").textContent="다른 익명 친구 녹음을 듣고 투표해보세요."}else if((j.recordings||[]).length>=3){$("#record").disabled=true;$("#record").textContent="고마! 이미 3명 완료 😂";$("#status").textContent="녹음은 마감됐지만 듣기와 투표는 가능합니다."}else{$("#status").textContent="한 번만 녹음하면 바로 익명으로 올라갑니다."}startPolling()}catch(e){$("#status").textContent=e.message}})();
</script></body></html>