    @media(max-width:360px){.phrase{font-size:30px}.mascotWrap{height:225px}.mascot{width:140px;height:140px}.eye{top:48px}.eye.l{left:42px}.eye.r{right:42px}.mouth{left:52px;top:84px}}
    @media(prefers-reduced-motion:reduce){.mascot.listening,.recording .wave i{animation:none}}
  </style>
