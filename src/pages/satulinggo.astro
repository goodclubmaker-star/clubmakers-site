    .mascot{position:relative;width:154px;height:154px;border-radius:46% 54% 48% 52%/53% 46% 54% 47%;background:var(--lime);border:3px solid var(--ink);transform-origin:50% 85%;transition:.2s}.mascot.listening{animation:breathe .65s ease-in-out infinite alternate}
    .ear{position:absolute;width:38px;height:52px;background:var(--lime);border:3px solid var(--ink);border-radius:55% 45% 55% 45%;top:45px;z-index:-1}.ear.l{left:-25px;transform:rotate(-22deg)}.ear.r{right:-25px;transform:scaleX(-1) rotate(-22deg)}
    .eye{position:absolute;width:13px;height:17px;background:var(--ink);border-radius:50%;top:52px}.eye.l{left:47px}.eye.r{right:47px}.mouth{position:absolute;width:38px;height:11px;border-bottom:5px solid var(--ink);border-radius:50%;left:58px;top:89px}
    .mic{position:absolute;right:-35px;bottom:-22px;width:58px;height:116px;transform:rotate(-18deg);filter:drop-shadow(0 6px 0 rgba(0,0,0,.08))}.micHead{width:42px;height:58px;border-radius:22px;background:var(--ink);border:3px solid var(--ink);position:absolute;left:8px;top:0}.micHead:after{content:"";position:absolute;left:9px;top:10px;width:18px;height:30px;border:2px solid rgba(255,255,255,.35);border-radius:12px}.micStem{position:absolute;left:25px;top:53px;width:8px;height:48px;border-radius:6px;background:var(--ink)}.micBase{position:absolute;left:11px;bottom:4px;width:36px;height:8px;border-radius:8px;background:var(--ink)}
    .wave{position:absolute;left:50%;bottom:8px;transform:translateX(-50%);display:flex;gap:4px;height:30px;align-items:center}.wave i{display:block;width:4px;height:7px;border-radius:4px;background:#cbc7be}.recording .wave i{background:var(--ink);animation:wave .55s ease-in-out infinite alternate}.recording .wave i:nth-child(2n){animation-delay:.14s}.recording .wave i:nth-child(3n){animation-delay:.28s}
    @keyframes wave{to{height:28px}}@keyframes breathe{to{transform:translateY(-4px) rotate(1deg)}}
