<html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>사투링고</title>
<style>
body{margin:0;background:#f4f1e9;color:#151515;font-family:-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Noto Sans KR",sans-serif}.app{max-width:520px;margin:auto;padding:16px}.top{display:flex;justify-content:space-between;padding:8px 2px 16px}.logo{font-size:26px;font-weight:900;letter-spacing:-2px}.brand{font-size:10px;font-weight:900}.hero,.card{border-radius:24px;margin-bottom:12px}.hero{background:#151515;color:white;padding:22px}.hero b{color:#caff3d;font-size:11px}.hero h1{font-size:29px;line-height:1.1;letter-spacing:-2px}.hero p{color:#bbb;font-size:13px}.card{background:white;border:1px solid #ddd9d0;padding:18px}.pill{background:#f0eee7;border-radius:20px;padding:7px 10px;font-size:12px;font-weight:900}.phrase{font-size:32px;font-weight:950;letter-spacing:-2px;margin:20px 0 8px}.meaning{font-size:13px;color:#777;margin-bottom:14px}.row{display:flex;gap:8px}.btn{border:0;border-radius:15px;padding:13px 15px;font-weight:900}.dark{background:#151515;color:white}.green{background:#caff3d}.light{background:#eeeae1}.record{width:100%;margin-top:9px;font-size:16px}.status{font-size:12px;color:#888;margin-top:8px}.mine,.friends,.invite,.result{display:none}.mine{background:#f7f5ef;border-radius:16px;padding:13px;margin-top:12px}.mine audio{width:100%;margin-top:8px}.person{display:flex;align-items:center;gap:7px;border-top:1px solid #eee;padding:10px 0}.info{flex:1}.name{font-weight:900;font-size:13px}.small{font-size:11px;color:#999}.play,.vote{border:1px solid #ddd;background:white;border-radius:10px;padding:7px}.selected{background:#151515!important;color:white}.result{background:#151515;color:white;border-radius:17px;padding:14px;margin-top:10px}.share{width:100%;margin-top:8px}.footer{text-align:center;color:#999;font-size:10px;padding:10px}
</style></head><body><main class="app">
<div class="top"><div class="logo">사투링고</div><div class="brand">낭만공작소</div></div>
<section class="hero"><b>JUST FOR FUN</b><h1>한마디 던지고<br>친구 목소리 들어보자.</h1><p>설치도 가입도 필요 없음.<br>듣고 · 녹음하고 · 웃고 · 바로 공유.</p></section>
<section class="card"><span class="pill" id="from">🎙️ 오늘의 한마디</span><div class="phrase" id="phrase">단디 입으래이.</div><div class="meaning" id="meaning">표준어: 옷 따뜻하게 잘 챙겨 입어.</div>
<div class="row"><button class="btn light" id="example">▶️ 예시 듣기</button><button class="btn dark" id="send">😈 친구한테 시키기</button></div>
<button class="btn green record" id="record">🎙️ 한 번만 녹음</button><div class="status" id="status">녹음은 한 번만 가능합니다.</div>
<div class="mine" id="mine"><b>내 녹음</b><audio id="audio" controls></audio></div>
<div class="friends" id="friends"><h3>친구 녹음 · 최대 3명</h3>
<div class="person"><div>😎</div><div class="info"><div class="name">단디맨</div><div class="small">부산 로컬</div></div><button class="play">▶️</button><button class="vote">😂</button><button class="vote">🔥</button><button class="vote">👍</button></div>
<div class="person"><div>🧑</div><div class="info"><div class="name">부산갈매기</div><div class="small">부산 로컬</div></div><button class="play">▶️</button><button class="vote">😂</button><button class="vote">🔥</button><button class="vote">👍</button></div>
<div class="person"><div>👩</div><div class="info"><div class="name">마이묵었다</div><div class="small">부산 로컬</div></div><button class="play">▶️</button><button class="vote">😂</button><button class="vote">🔥</button><button class="vote">👍</button></div>
<div class="result" id="result">😂😂🔥<h2>부산이 무너졌다 😂</h2><p>친구 3명의 판정이 끝났습니다.</p><button class="btn light share" id="share">📤 친구에게 알리기</button><button class="btn green share" id="counter">😈 니도 해봐라</button></div></div>
<div class="invite" id="invite"><b>😈 바로 던지기</b><p class="small">카톡으로 링크 하나만 보내세요.</p><div class="row"><button class="btn green" id="shareInvite">💬 카톡으로 보내기</button><button class="btn light" id="copy">링크 복사</button></div></div></section>
<section class="card"><div class="row"><button class="btn light" id="another" style="flex:1">🎲 다른 한마디</button><button class="btn dark" id="custom" style="flex:1">✏️ 직접 던지기</button></div></section>
<div class="footer">사투링고 · 낭만공작소</div></main>
<script>
var lessons=[["단디 입으래이.","옷 따뜻하게 잘 챙겨 입어."],["가가 가가?","걔가 그 애냐?"],["밥 뭇나?","밥 먹었니?"],["퍼뜩 온나.","빨리 와."],["그라제.","그렇지."],["거시기 좀 갖고 와.","그것 좀 가져와."]],n=0,rec,chunks=[],done=false;
function $(x){return document.querySelector(x)}function speak(t){var u=new SpeechSynthesisUtterance(t);u.lang="ko-KR";u.rate=.78;speechSynthesis.cancel();speechSynthesis.speak(u)}
function load(x){$("#phrase").textContent=x[0];$("#meaning").textContent="표준어: "+x[1];$("#friends").style.display="none";$("#result").style.display="none";$("#invite").style.display="none";$("#mine").style.display="none";$("#record").disabled=false;$("#record").textContent="🎙️ 한 번만 녹음";$("#status").textContent="녹음은 한 번만 가능합니다.";done=false}
$("#example").onclick=function(){speak(lessons[n][0])};$("#another").onclick=function(){n=(n+1)%lessons.length;load(lessons[n])};$("#send").onclick=function(){$("#invite").style.display="block"};
$("#record").onclick=async function(){if(done)return;try{var s=await navigator.mediaDevices.getUserMedia({audio:true});chunks=[];rec=new MediaRecorder(s);rec.ondataavailable=function(e){chunks.push(e.data)};rec.onstop=function(){s.getTracks().forEach(function(t){t.stop()});$("#audio").src=URL.createObjectURL(new Blob(chunks,{type:"audio/webm"}));$("#mine").style.display="block";$("#record").disabled=true;$("#record").textContent="✓ 녹음 완료";$("#status").textContent="좋다. 이제 친구한테 시켜봐라 😂";done=true;$("#invite").style.display="block"};rec.start();$("#record").textContent="■ 녹음 중…";setTimeout(function(){if(rec.state==="recording")rec.stop()},7000)}catch(e){$("#status").textContent="마이크 권한을 허용해주세요."}};
document.querySelectorAll(".play").forEach(function(b){b.onclick=function(){speak(lessons[n][0])}});document.querySelectorAll(".vote").forEach(function(b){b.onclick=function(){var a=b.parentElement.querySelectorAll(".vote");a.forEach(function(x){x.classList.remove("selected")});b.classList.add("selected");if(document.querySelectorAll(".vote.selected").length===3)$("#result").style.display="block"}});
async function share(t,title){if(navigator.share){try{await navigator.share({title:title,text:t})}catch(e){}}else{await navigator.clipboard.writeText(t);alert("공유 문구를 복사했습니다.")}}
$("#shareInvite").onclick=function(){share("😈 사투링고 미션 “"+lessons[n][0]+"” 한번 해봐라! "+location.href.split("#")[0]+"#mission="+encodeURIComponent(lessons[n][0]),"사투링고 미션")};$("#copy").onclick=async function(){await navigator.clipboard.writeText(location.href.split("#")[0]+"#mission="+encodeURIComponent(lessons[n][0]));alert("미션 링크를 복사했습니다.")};$("#share").onclick=function(){share("😂 사투링고 결과 “"+lessons[n][0]+"” 미션 결과가 나왔다!","사투링고 결과")};$("#counter").onclick=function(){$("#send").click()};$("#custom").onclick=function(){var x=prompt("친구에게 시킬 한마디");if(x){lessons.push([x,"직접 만든 미션"]);n=lessons.length-1;load(lessons[n])}};
var h=location.hash.match(/#mission=([^&]+)/);if(h){$("#from").textContent="😈 친구가 던짐";$("#phrase").textContent=decodeURIComponent(h[1]);$("#meaning").textContent="친구가 시킨 한마디입니다.";$("#send").style.display="none"}
</script></body></html>