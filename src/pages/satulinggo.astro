    .top{display:flex;align-items:center;justify-content:space-between;padding:6px 2px 14px}.logo{font-size:27px;font-weight:950;letter-spacing:-2px}.brand{font-size:10px;font-weight:900;letter-spacing:.2px;color:#6f6b62}
    .progress{display:flex;gap:5px;align-items:center}.dot{width:7px;height:7px;border-radius:50%;background:#d3cfc5}.dot.on{width:22px;border-radius:99px;background:var(--ink)}
    .stage{background:var(--white);border:1px solid var(--line);border-radius:28px;padding:18px;overflow:hidden}.eyebrow{display:flex;align-items:center;justify-content:space-between;gap:8px}.tag{display:inline-flex;align-items:center;gap:5px;background:#f0ede5;border-radius:99px;padding:7px 10px;font-size:12px;font-weight:900}.tiny{font-size:11px;color:var(--muted);font-weight:700}
    .phrase{font-size:34px;line-height:1.06;font-weight:950;letter-spacing:-2.2px;text-align:center;margin:20px 6px 8px;word-break:keep-all}.hint{text-align:center;color:var(--muted);font-size:13px;font-weight:650;min-height:19px}
