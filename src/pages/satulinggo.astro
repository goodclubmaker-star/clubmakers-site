<body>
<main class="app">
  <header class="top">
    <div class="logo">사투링고</div>
    <div class="progress" aria-label="진행 단계"><span class="dot on"></span><span class="dot"></span><span class="dot"></span></div>
    <div class="brand">낭만공작소</div>
  </header>

  <section class="stage" id="stage">
    <div class="eyebrow">
