    .review,.kakao,.social,.invite,.result{display:none}.review{margin-top:14px;padding:14px;background:#f7f5ef;border-radius:18px}.reviewTitle{font-weight:950;margin-bottom:9px}.review audio,.person audio{width:100%}.review .subactions{margin-top:10px}
    .kakao{margin-top:14px;background:#fff3cc;border:1px solid #e8cb66;border-radius:18px;padding:14px}.kakao b{display:block;margin-bottom:5px}.kakao p{margin:0 0 10px;font-size:12px;line-height:1.5;color:#665819}
    .post{margin-top:12px}.social{margin-top:12px;background:#fff;border:1px solid var(--line);border-radius:24px;padding:16px}.socialHead{display:flex;align-items:end;justify-content:space-between;margin-bottom:6px}.socialHead h3{margin:0;font-size:18px}.rankTitle{font-size:12px;font-weight:950;color:#6d685f;margin:14px 0 3px}.slot{padding:13px;border:1px dashed #d3cfc4;border-radius:14px;margin-top:8px;color:var(--muted);font-size:13px}.person{border-top:1px solid #eeeae2;padding:13px 0}.person:first-of-type{border-top:0}.personHead{display:flex;align-items:center;gap:9px}.avatar{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:#f1eee7;color:var(--ink);font-size:19px}.info{flex:1}.name{font-size:13px;font-weight:950}.small{font-size:11px;color:#918d84}.score{font-size:11px;font-weight:900;color:#777}.votes{display:flex;gap:6px;margin-top:8px}.vote{flex:1;border:1px solid var(--line);background:#fff;border-radius:12px;padding:9px 8px;font-weight:900}.deleteMine{border:0;background:transparent;color:#b23a3a;font-size:11px;font-weight:900;padding:6px 0;margin-top:4px}.moreCard{margin-top:10px;border:1px solid var(--line);border-radius:16px;background:#faf8f3;overflow:hidden}.moreCard summary{list-style:none;cursor:pointer;padding:13px 14px;font-size:13px;font-weight:950}.moreCard summary::-webkit-details-marker{display:none}.moreCard[open] summary{border-bottom:1px solid var(--line)}.moreInner{padding:0 14px}.result{background:var(--ink);color:#fff;border-radius:18px;padding:14px;margin-top:10px}.result h3{margin:0 0 5px}.result p{margin:0 0 9px;color:#c8c8c8;font-size:12px}
