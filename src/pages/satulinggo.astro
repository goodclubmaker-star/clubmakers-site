  <style>
    :root{--ink:#171717;--lime:#c7ff3d;--paper:#f6f3eb;--muted:#78746b;--line:#dedad0;--white:#fff;--red:#ff4d4f}
    *{box-sizing:border-box} body{margin:0;background:var(--paper);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Noto Sans KR",sans-serif}
