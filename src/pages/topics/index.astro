<style>
  :root {
    --bg: #F8F5EE; --bg-elev: #FFFFFF; --bg-soft: #F1ECE0;
    --text: #1F1B16; --text-2: #3A332A; --muted: #6B6358;
    --rule: #E2DACA; --rule-2: #D2C9B5;
    --accent: #2C5F4F; --accent-2: #87A99B; --accent-soft: #E6EDE7;
    --warn: #B5462E; --warn-soft: #F6E8E1;
    --serif: "Noto Serif KR", "Apple SD Gothic Neo", serif;
    --sans:  "Pretendard", "Apple SD Gothic Neo", system-ui, sans-serif;
  }
  .container { width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .narrow { max-width: 760px; }

  .eyebrow { font-family: var(--sans); font-size: .75rem; font-weight: 600; letter-spacing: .15em; color: var(--accent); text-transform: uppercase; margin: 0 0 1.25rem; }

  /* HERO */
  .topics-hero { background: var(--bg); padding: 96px 0 72px; border-bottom: 1px solid var(--rule); }
  .topics-title {
    font-family: var(--serif);
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -.02em;
    color: var(--text);
    margin: 0 0 1.75rem;
  }
  .topics-title em { font-style: normal; color: var(--accent); font-weight: 600; }
  .topics-lead {
    font-family: var(--sans);
    font-size: 1.125rem;
    line-height: 1.85;
    color: var(--text-2);
    max-width: 680px;
    margin: 0;
  }
  .topics-lead strong { color: var(--text); font-weight: 600; }

  /* SECTION TITLE */
  .section-title {
    font-family: var(--serif);
    font-size: clamp(1.75rem, 4.2vw, 2.5rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.015em;
    color: var(--text);
    margin: 0 0 2rem;
  }
  .section-title em { font-style: normal; color: var(--accent); }

  /* PRINCIPLE */
  .principle-section { padding: 80px 0; border-top: 1px solid var(--rule); }
  .prose p { font-family: var(--sans); font-size: 1.0625rem; line-height: 1.85; color: var(--text-2); margin: 0 0 1.1em; }
  .prose p strong { color: var(--text); font-weight: 600; }

  .order-card {
    background: var(--text);
    color: var(--bg);
    padding: 36px 36px 32px;
    border-radius: 4px;
    border-left: 4px solid var(--accent-2);
    margin: 2.5rem 0;
  }
  .order-label {
    font-family: var(--sans);
    font-size: .8125rem;
    font-weight: 700;
    color: var(--accent-2);
    letter-spacing: .12em;
    text-transform: uppercase;
    margin: 0 0 1.5rem;
  }
  .order-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    counter-reset: ord;
  }
  .order-list li {
    counter-increment: ord;
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255,255,255,.88);
    padding: .85rem 0 .85rem 0;
    border-bottom: 1px solid rgba(255,255,255,.08);
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .order-list li:last-child { border-bottom: none; }
  .order-list li:before {
    content: counter(ord);
    font-family: var(--serif);
    font-size: 1.125rem;
    color: var(--accent-2);
    min-width: 1.5rem;
    font-weight: 500;
  }
  .order-foot {
    font-family: var(--sans);
    font-size: .9375rem;
    line-height: 1.7;
    color: rgba(255,255,255,.7);
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255,255,255,.12);
  }
  .order-foot strong { color: white; font-weight: 600; }

  /* TOPICS GRID */
  .topics-grid-section { padding: 80px 0; background: var(--bg); border-top: 1px solid var(--rule); }
  .grid-head { max-width: 760px; margin: 0 auto 3rem; padding: 0 24px; }
  .topics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 720px) { .topics-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .topics-grid { grid-template-columns: repeat(3, 1fr); } }

  .topic-card {
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    padding: 32px 28px 28px;
    border-radius: 2px;
    text-decoration: none;
    color: var(--text);
    transition: transform .25s, border-color .25s, background .25s;
    display: flex;
    flex-direction: column;
    position: relative;
    min-height: 240px;
  }
  .topic-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .topic-card:hover .topic-card-arrow { color: var(--accent); transform: translateX(4px); }

  .topic-num {
    font-family: var(--serif);
    font-size: 2.25rem;
    line-height: 1;
    color: var(--accent);
    margin: 0 0 1rem;
    font-weight: 500;
    opacity: .35;
  }
  .topic-card:hover .topic-num { opacity: 1; }

  .topic-card-label {
    font-family: var(--sans);
    font-size: .8125rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: .1em;
    text-transform: uppercase;
    margin: 0 0 .5rem;
  }
  .topic-card-title {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text);
    margin: 0 0 .75rem;
    line-height: 1.4;
  }
  .topic-card-desc {
    font-family: var(--sans);
    font-size: .9375rem;
    line-height: 1.65;
    color: var(--text-2);
    margin: 0 0 1.5rem;
    flex: 1;
  }
  .topic-card-quotes {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }
  .topic-card-quotes li {
    font-family: var(--sans);
    font-size: .8125rem;
    line-height: 1.6;
    color: var(--text-2);
    padding: 4px 0 4px 14px;
    position: relative;
    font-style: italic;
    opacity: 0.85;
  }
  .topic-card-quotes li::before {
    content: '"';
    position: absolute;
    left: 0;
    top: 2px;
    color: var(--accent);
    font-size: 1rem;
    font-weight: 700;
    font-style: normal;
  }
  .topic-card-quotes li::after {
    content: '"';
    color: var(--accent);
    font-weight: 700;
    font-style: normal;
    margin-left: 1px;
  }
  .topic-card-new {
    position: relative;
  }
  .topic-card-new::after {
    content: 'NEW';
    position: absolute;
    top: 16px;
    right: 20px;
    background: var(--accent-2);
    color: white;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 3px 7px;
    border-radius: 100px;
  }
  .grid-sub {
    font-family: var(--sans);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-2);
    max-width: 640px;
    margin: 1rem auto 0;
    text-align: center;
  }
  .topic-card-arrow {
    font-size: 1.25rem;
    color: var(--accent-2);
    transition: color .25s, transform .25s;
    align-self: flex-start;
  }

  /* ============================================ */
  /* STICKY INDEX BAR — 상단 고정 색인 */
  /* ============================================ */
  .topics-sticky-bar {
    position: sticky;
    top: 60px; /* Nav height */
    z-index: 50;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line, #EAE7E0);
    border-top: 1px solid var(--line, #EAE7E0);
  }
  .topics-sticky-list {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding: 10px 0;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }
  .topics-sticky-list::-webkit-scrollbar { height: 4px; }
  .topics-sticky-list::-webkit-scrollbar-thumb {
    background: var(--line, #EAE7E0);
    border-radius: 100px;
  }
  .topics-sticky-chip {
    display: inline-block;
    flex-shrink: 0;
    font-family: var(--sans, sans-serif);
    font-size: 12px;
    font-weight: 600;
    color: var(--text-2, #5A5A57);
    padding: 6px 12px;
    border: 1px solid var(--line, #EAE7E0);
    border-radius: 100px;
    text-decoration: none;
    background: var(--bg, #FFFFFF);
    transition: all 0.15s;
    white-space: nowrap;
  }
  .topics-sticky-chip:hover {
    background: var(--accent, #0F2922);
    color: var(--bg, #FFFFFF);
    border-color: var(--accent, #0F2922);
    transform: translateY(-1px);
  }
  .topics-sticky-chip-new {
    border-color: var(--accent-2, #B8985C);
    color: var(--accent-2, #B8985C);
  }
  .topics-sticky-chip-new:hover {
    background: var(--accent-2, #B8985C);
    color: var(--bg, #FFFFFF);
    border-color: var(--accent-2, #B8985C);
  }

  /* 모바일에서 sticky bar 위치 미세 조정 */
  @media (max-width: 720px) {
    .topics-sticky-bar { top: 56px; }
    .topics-sticky-chip {
      font-size: 11.5px;
      padding: 5px 10px;
    }
    .topics-sticky-list { padding: 8px 0; gap: 5px; }
  }

  /* ============================================ */
  /* TAG CLOUD — 친숙 표현 입구 */
  /* ============================================ */
  .topics-tagcloud-section {
    padding: 64px 0;
    background: var(--bg-soft, #FAFAF6);
    border-bottom: 1px solid var(--line, #EAE7E0);
  }
  .topics-tagcloud-section .eyebrow {
    margin-bottom: 0.5rem;
  }
  .topics-tagcloud-section .section-title {
    margin-bottom: 1rem;
  }
  .tagcloud-lead {
    font-family: var(--sans, sans-serif);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-2, #5A5A57);
    margin: 0 0 2rem;
    max-width: 580px;
  }
  .topics-tagcloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .topics-tag {
    display: inline-block;
    font-family: var(--sans, sans-serif);
    font-size: 13px;
    font-weight: 500;
    color: var(--text, #0F0F0E);
    padding: 8px 14px;
    border: 1px solid var(--line, #EAE7E0);
    border-radius: 100px;
    text-decoration: none;
    background: var(--bg, #FFFFFF);
    transition: all 0.15s;
  }
  .topics-tag:hover {
    background: var(--accent, #0F2922);
    color: var(--bg, #FFFFFF);
    border-color: var(--accent, #0F2922);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(15, 41, 34, 0.1);
  }
  .topics-tag-star {
    background: var(--cream, #F8F2E5);
    border-color: var(--accent-2, #B8985C);
    color: var(--text, #0F0F0E);
    font-weight: 600;
    font-style: italic;
  }
  .topics-tag-star:hover {
    background: var(--accent-2, #B8985C);
    color: var(--bg, #FFFFFF);
    border-color: var(--accent-2, #B8985C);
  }

  @media (max-width: 720px) {
    .topics-tagcloud-section { padding: 48px 0; }
    .topics-tag { font-size: 12.5px; padding: 7px 12px; }
  }

  /* 카드 점프 시 sticky bar에 가려지지 않게 */
  .topic-card[id] {
    scroll-margin-top: 130px;
  }

  /* CTA */
  .cta-section { background: var(--text); color: var(--bg); padding: 96px 0; }
  .cta-section .eyebrow { color: var(--accent-2); }
  .cta-section .section-title { color: var(--bg); }
  .cta-section .section-title em { color: var(--accent-2); }
  .cta-lead {
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.85;
    color: rgba(255,255,255,.85);
    margin: 0 0 2.5rem;
  }
  .cta-lead strong { color: white; font-weight: 600; }
  .cta-buttons { display: flex; flex-wrap: wrap; gap: 1rem; }
  .btn-primary, .btn-secondary {
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 600;
    padding: 16px 28px;
    border-radius: 2px;
    text-decoration: none;
    transition: transform .2s, background .2s;
    display: inline-flex;
    align-items: center;
    gap: .75rem;
  }
  .btn-primary { background: var(--accent); color: white; border: 1px solid var(--accent); }
  .btn-primary:hover { background: var(--accent-2); border-color: var(--accent-2); transform: translateX(2px); }
  .btn-secondary { background: transparent; color: var(--accent-2); border: 1px solid rgba(255,255,255,.25); }
  .btn-secondary:hover { background: rgba(255,255,255,.06); color: white; border-color: rgba(255,255,255,.4); }

  @media (max-width: 480px) {
    .topics-hero { padding: 64px 0 48px; }
    .principle-section, .topics-grid-section, .cta-section { padding: 64px 0; }
    .order-card { padding: 26px 22px; }
    .topic-card { padding: 26px 22px; min-height: 200px; }
  }

  /* ===== 원고 기반 추가 섹션 ===== */
  .how-section, .misread-section, .before-section { padding: 80px 0; background: var(--bg); border-top: 1px solid var(--rule); }
  .trace-steps { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: 1fr; gap: .75rem; }
  @media (min-width: 720px) { .trace-steps { grid-template-columns: repeat(4, 1fr); } }
  .trace-steps li { background: var(--bg-elev); border: 1px solid var(--rule); border-top: 3px solid var(--accent); padding: 18px 16px; display: flex; flex-direction: column; gap: .25rem; }
  .trace-en { font-family: var(--sans); font-size: .6875rem; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-2); font-weight: 600; }
  .trace-steps strong { font-family: var(--serif); font-size: 1.25rem; font-weight: 500; color: var(--text); }
  .trace-steps li span:last-child { font-family: var(--sans); font-size: .875rem; color: var(--text-2); line-height: 1.55; }

  .six-section, .cases-section { padding: 80px 0; background: var(--bg-soft); border-top: 1px solid var(--rule); }
  .six-grid, .cases-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 720px) { .six-grid, .cases-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .six-grid { grid-template-columns: repeat(3, 1fr); } .cases-grid { grid-template-columns: repeat(4, 1fr); } }
  .six-item, .case-item { background: var(--bg-elev); border: 1px solid var(--rule); padding: 24px 22px; border-radius: 2px; }
  .six-num { font-family: var(--serif); font-size: 2rem; line-height: 1; color: var(--accent); opacity: .4; margin: 0 0 .75rem; }
  .six-item h3, .case-item h3 { font-family: var(--serif); font-size: 1.2rem; font-weight: 500; margin: 0 0 .5rem; color: var(--text); }
  .six-item p { font-family: var(--sans); font-size: .9375rem; line-height: 1.65; color: var(--text-2); margin: 0 0 .75rem; }
  .six-links { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0 !important; }
  .six-links a { font-size: .8125rem; color: var(--accent); background: var(--accent-soft); padding: 3px 10px; border-radius: 100px; text-decoration: none; }
  .six-links a:hover { background: var(--accent); color: white; }

  .misread-list { display: flex; flex-direction: column; gap: .75rem; margin-top: 1.5rem; }
  .misread-item { background: var(--bg-elev); border: 1px solid var(--rule); border-left: 4px solid var(--warn); padding: 18px 20px; }
  .misread-data { font-family: var(--serif); font-size: 1.125rem; color: var(--text); margin: 0 0 .4rem; }
