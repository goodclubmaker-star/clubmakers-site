<!-- 2026 seasonal interactive Christmas tree popup; homepage only. -->
<div id="cm-xmas-root" class="cm-xmas" data-state="closed">
  <button id="cm-xmas-bubble" class="cm-xmas-bubble" type="button" aria-label="크리스마스트리 열기">🎄 <span>이름 달기</span></button>
  <div id="cm-xmas-overlay" class="cm-xmas-overlay" role="presentation" hidden>
    <div id="cm-xmas-dialog" class="cm-xmas-dialog" role="dialog" aria-modal="true" aria-labelledby="cm-xmas-title" tabindex="-1">
      <header class="cm-xmas-header">
        <div class="cm-xmas-heading">
          <span class="cm-xmas-kicker">CLUBMAKERS · CHRISTMAS 2026</span>
          <h2 id="cm-xmas-title">🎄 함께 꾸미는 크리스마스트리</h2>
          <p>이름을 장식하고 빛나는 축하를 즐겨보세요. 카드 저장과 음악이 담긴 영상 만들기도 가능해요.</p>
        </div>
        <button id="cm-xmas-close" class="cm-xmas-close" type="button" aria-label="크리스마스트리 팝업 닫기">×</button>
      </header>
      <iframe id="cm-xmas-frame" class="cm-xmas-frame" title="골프채공작소 공동 크리스마스트리" loading="lazy" allow="autoplay; web-share" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      <footer class="cm-xmas-bottom">
        <span>♫ 캐롤은 트리 안에서 직접 켤 수 있어요</span>
        <a href="/christmas/" target="_blank" rel="noopener noreferrer">전체 화면으로 보기 ↗</a>
      </footer>
    </div>
  </div>
</div>
<style>
.cm-xmas-bubble{position:fixed;left:18px;bottom:22px;z-index:80;display:flex;align-items:center;gap:8px;border:1px solid #e6cf90;background:#14362a;color:#fff7dc;border-radius:100px;padding:12px 16px;font-family:inherit;font-size:13px;font-weight:750;box-shadow:0 8px 28px #051b1370;cursor:pointer;transition:transform .2s}
.cm-xmas-bubble:hover,.cm-xmas-bubble:focus-visible{transform:translateY(-3px);outline-offset:3px}
.cm-xmas-overlay{position:fixed;inset:0;z-index:400;background:rgba(4,14,13,.7);display:grid;place-items:center;padding:16px;backdrop-filter:blur(5px)}
.cm-xmas-overlay[hidden]{display:none}
.cm-xmas-dialog{background:#0d1d19;width:min(430px,100%);height:min(740px,90dvh);min-height:330px;max-height:calc(100dvh - 24px);border:1px solid #c4a25b88;border-radius:20px;box-shadow:0 24px 80px #000a;overflow:hidden;display:flex;flex-direction:column;color:#fffaf0}
.cm-xmas-header{display:flex;justify-content:space-between;gap:10px;padding:17px 17px 12px;background:linear-gradient(130deg,#123e31,#12201c);border-bottom:1px solid #d6b77642}
.cm-xmas-heading{min-width:0}
.cm-xmas-kicker{font-size:10px;letter-spacing:.18em;color:#e7cc94}
.cm-xmas-heading h2{font-size:17px;line-height:1.4;font-weight:750;color:#fffaf0;margin:5px 0}
.cm-xmas-heading p{font-size:11px;line-height:1.5;color:#d6e5d7;margin:0}
.cm-xmas-close{align-self:flex-start;flex-shrink:0;width:36px;height:36px;background:#ffffff13;border:1px solid #ffffff45;color:#fff;font-size:27px;line-height:1;border-radius:50%;cursor:pointer}
.cm-xmas-frame{flex:1;min-height:0;width:100%;border:0;display:block;background:#030913}
.cm-xmas-bottom{background:#10221a;border-top:1px solid #d6b77642;padding:9px 14px;display:flex;justify-content:space-between;gap:12px;align-items:center;font-size:10px;line-height:1.3;color:#d2c7ad}
.cm-xmas-bottom a{color:#ffe09c;font-size:11px;text-decoration:underline;white-space:nowrap}
@media(max-width:600px){
 .cm-xmas-bubble{left:12px;bottom:calc(env(safe-area-inset-bottom,0px) + 12px);padding:11px 14px}
 .cm-xmas-overlay{padding:6px}
 .cm-xmas-dialog{height:calc(100dvh - 12px);max-height:calc(100dvh - 12px);border-radius:16px}
 .cm-xmas-header{padding:11px 12px}
 .cm-xmas-heading h2{font-size:15px}
 .cm-xmas-bottom{padding:9px 12px}
}
@media(prefers-reduced-motion:reduce){.cm-xmas-bubble{transition:none}}
</style>
<script is:inline>
(() => {
 const root=document.getElementById('cm-xmas-root');
 const overlay=document.getElementById('cm-xmas-overlay');
 const dialog=document.getElementById('cm-xmas-dialog');
 const bubble=document.getElementById('cm-xmas-bubble');
 const close=document.getElementById('cm-xmas-close');
 const frame=document.getElementById('cm-xmas-frame');
 if(!root||!overlay||!bubble||!frame)return;
 const key='cm-christmas-popup-2026-shown';
 let previousFocus=null,previousOverflow='';
 function openPopup(){
  if(!overlay.hidden)return;
  previousFocus=document.activeElement;previousOverflow=document.body.style.overflow;
  overlay.hidden=false;root.dataset.state='open';
  if(!frame.src || frame.getAttribute('src')===null)frame.src='/christmas/';
  document.body.style.overflow='hidden';
  dialog.focus({preventScroll:true});
  try{sessionStorage.setItem(key,'1')}catch(e){}
 }
 function closePopup(){
  if(overlay.hidden)return;
  overlay.hidden=true;root.dataset.state='closed';
  document.body.style.overflow=previousOverflow;
  if(previousFocus&&typeof previousFocus.focus==='function')previousFocus.focus({preventScroll:true});
 }
 bubble.addEventListener('click',openPopup);
 close.addEventListener('click',closePopup);
 overlay.addEventListener('click',e=>{if(e.target===overlay)closePopup()});
 document.addEventListener('keydown',e=>{
  if(overlay.hidden)return;
  if(e.key==='Escape')closePopup();
  if(e.key==='Tab'&&document.activeElement===close&&e.shiftKey){e.preventDefault();dialog.focus()}
 });
 let shown=false;try{shown=sessionStorage.getItem(key)==='1'}catch(e){}
 if(!shown)window.setTimeout(openPopup,1200);
})();
</script>